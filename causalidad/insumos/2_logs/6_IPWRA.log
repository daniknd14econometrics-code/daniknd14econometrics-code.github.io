. program define ipwra_diff_manu_serv, rclass
  1.     version 19.0
  2.     syntax , DVAR(name) YVAR(name) XTR(string asis) XY(string asis) SECTOR(name) ///
>         [VCETYPE(string) CLUSTERVAR(name) MINCELL(integer 30) MAXITER(integer 55)]
  3. 
.     * Defaults
.     if ("`vcetype'"=="")    local vcetype "robust"
  4.     if ("`clustervar'"=="") local clustervar "correlativo"
  5.     if ("`mincell'"=="")    local mincell = 30
  6.     if ("`maxiter'"=="")    local maxiter = 55
  7. 
.     * Normalizar strings + retokenize
.     local xtr : subinstr local xtr `"""' "", all
  8.     local xy  : subinstr local xy  `"""' "", all
  9.     local xtr : list retokenize xtr
 10.     local xy  : list retokenize xy
 11. 
.     * Remover i.macro_sector si viniera
.     local xtr0 : subinstr local xtr "i.macro_sector" "", all
 12.     local xy0  : subinstr local xy  "i.macro_sector" "", all
 13.     local xtr0 : list retokenize xtr0
 14.     local xy0  : list retokenize xy0
 15. 
.     * VCE option
.     local vceopt "vce(`vcetype')"
 16.     if (lower("`vcetype'")=="cluster") local vceopt "vce(cluster `clustervar')"
 17. 
.     * Salidas
.     tempname a1m a2m a3m a1s a2s a3s b
 18.     scalar `a1m' = .
 19.     scalar `a2m' = .
 20.     scalar `a3m' = .
 21.     scalar `a1s' = .
 22.     scalar `a2s' = .
 23.     scalar `a3s' = .
 24. 
.     foreach s in 1 2 {
 25. 
.         preserve
 26.             keep if `sector'==`s'
 27.             keep if inlist(`dvar',0,1,2,3)
 28.             drop if missing(`yvar')
 29. 
.             forvalues t=1/3 {
 30. 
.                 quietly count if `dvar'==`t'
 31.                 local Nt = r(N)
 32.                 quietly count if `dvar'==0
 33.                 local N0 = r(N)
 34. 
.                 * Fail fast
.                 if (`Nt' < `mincell' | `N0' < `mincell') continue
 35. 
.                 quietly capture teffects ipwra ///
>                     (`yvar' `xy0', logit) ///
>                     (`dvar' `xtr0', mlogit), ///
>                     atet control(0) tlevel(`t') `vceopt' iterate(`maxiter')
 36. 
.                 if (_rc==0 & e(converged)==1) {
 37. 
.                     matrix `b' = e(b)
 38.                     local cn : colfullnames `b'
 39. 
.                     * ======= TU LÓGICA ORIGINAL (sin inventar) =======
.                     local atetcols ""
 40.                     foreach nm of local cn {
 41.                         if (substr("`nm'",1,5)=="ATET:") local atetcols "`atetcols' `nm'"
 42.                     }
 43. 
.                     local diagcol : word `t' of `atetcols'
 44. 
.                     * Airbag: si por algún motivo no existe la palabra t, caer al 1ro
.                     if ("`diagcol'"=="") local diagcol : word 1 of `atetcols'
 45.                     if ("`diagcol'"=="") continue
 46. 
.                     local j = colnumb(`b', "`diagcol'")
 47.                     if (`j'<=0) continue
 48. 
.                     scalar __atet = el(`b', 1, `j')
 49.                     * ================================================
. 
.                     if (`s'==1 & `t'==1) scalar `a1m' = __atet
 50.                     if (`s'==1 & `t'==2) scalar `a2m' = __atet
 51.                     if (`s'==1 & `t'==3) scalar `a3m' = __atet
 52.                     if (`s'==2 & `t'==1) scalar `a1s' = __atet
 53.                     if (`s'==2 & `t'==2) scalar `a2s' = __atet
 54.                     if (`s'==2 & `t'==3) scalar `a3s' = __atet
 55.                 }
 56.             }
 57.         restore
 58.     }
 59. 
.     local ok = 1
 60.     if (missing(`a1m') | missing(`a2m') | missing(`a3m') | ///
>         missing(`a1s') | missing(`a2s') | missing(`a3s')) local ok = 0
 61. 
.     return scalar ok    = `ok'
 62.     return scalar a1m   = `a1m'
 63.     return scalar a2m   = `a2m'
 64.     return scalar a3m   = `a3m'
 65.     return scalar a1s   = `a1s'
 66.     return scalar a2s   = `a2s'
 67.     return scalar a3s   = `a3s'
 68.     return scalar diff1 = (`a1m' - `a1s')
 69.     return scalar diff2 = (`a2m' - `a2s')
 70.     return scalar diff3 = (`a3m' - `a3s')
 71. end

. 
. 
. 
. 
. 
. ***************************
. 
. *log using "`outdir'\ATET_IGNORE_S1_SECTORDIFF_BOOT.log", replace
. 
. 
. ereturn list

scalars:
               e(rank) =  27
                  e(N) =  2008
                 e(ic) =  4
                  e(k) =  27
               e(k_dv) =  1
          e(converged) =  1
                 e(rc) =  0
                 e(ll) =  -2569.664064353242
               e(ll_0) =  -2656.274042836801
               e(df_m) =  24
               e(chi2) =  173.2199569671184
                  e(p) =  1.43229960187e-24
               e(N_cd) =  0
           e(ibaseout) =  1
            e(baseout) =  0
               e(k_eq) =  4
         e(k_eq_model) =  4
          e(k_eq_base) =  1
               e(r2_p) =  .0326058144178012
              e(k_out) =  4

macros:
            e(cmdline) : "mlogit D_pp_ignore edad capital_extranjero share_prof_tecn exp_dummy ln_tpo_mean indice_redes                   redesXexp redesXsize, b.."
                e(cmd) : "mlogit"
     e(marginsdefault) : "predict(pr outcome(0)) predict(pr outcome(1)) predict(pr outcome(2)) predict(pr outcome(3))"
       e(marginsnotok) : "stdp stddp SCores"
            e(predict) : "mlogit_p"
              e(title) : "Multinomial logistic regression"
            e(eqnames) : "No_prod_proc Solo_producto Solo_proceso Ambas"
            e(baselab) : "No prod/proc"
           e(chi2type) : "LR"
  e(deriv_useminbound) : "off"
                e(opt) : "moptimize"
                e(vce) : "oim"
               e(user) : "mopt__mlogit_d2()"
          e(ml_method) : "d2"
          e(technique) : "nr"
              e(which) : "max"
             e(depvar) : "D_pp_ignore"
         e(properties) : "b V"

matrices:
                  e(b) :  1 x 36
                  e(V) :  36 x 36
           e(gradient) :  1 x 36
                e(out) :  1 x 4
               e(ilog) :  1 x 20

functions:
             e(sample)   

. 
. ereturn clear

. estimates clear

. 
. * una vez
. use "BOOTBASE_FIXED.dta", clear

. ipwra_diff_manu_serv, dvar(D_pp_ignore) yvar(Y_cond) sector(macro_sector) ///
>     xtr("`XTR0'") xy("`XY0'") ///
>     vcetype(robust)
(1,989 observations deleted)
(0 observations deleted)
(0 observations deleted)
(2,349 observations deleted)
(0 observations deleted)
(0 observations deleted)

. 
. return list

scalars:
              r(diff3) =  .1173687272767969
              r(diff2) =  .0082829967058639
              r(diff1) =  -.0024453446718873
                r(a3s) =  .2036918626241321
                r(a2s) =  .1786661826205798
                r(a1s) =  .1135405998975551
                r(a3m) =  .3210605899009289
                r(a2m) =  .1869491793264436
                r(a1m) =  .1110952552256678
                 r(ok) =  1

. * chequeo rápido
. di as txt "ok = " %9.0g r(ok) " | diff1=" %9.4f r(diff1) " diff2=" %9.4f r(diff2) " diff3=" %9.4f r(diff3)
ok =         1 | diff1=  -0.0024 diff2=   0.0083 diff3=   0.1174

. 
. /*
> * bootstrap: una prueba rapida de 4 reps
> use "BOOTBASE_FIXED.dta", clear
> set seed 12345
> xtset, clear
> 
> bootstrap r(diff1) r(diff2) r(diff3), reps(4)  cluster(correlativo)  strata(macro_sector) : ///
>     ipwra_diff_manu_serv, dvar(D_pp_ignore) yvar(Y_cond) sector(macro_sector) ///
>         xtr("`XTR0'") xy("`XY0'") vcetype(robust)
> 
> * opcional: ver tabla guardada en e(b), e(V) del bootstrap
> ereturn list
> */
. 
. 
. ********************* metodo de bootstrap acelerado: parallel ************************
.                 
. *------------------------------------------------------------
. * 0) Recomendación práctica: guardá BOOTBASE_FIXED a disco
. *------------------------------------------------------------
. use "BOOTBASE_FIXED.dta", clear

. 
. xtset, clear

. set seed 12345

. 
. *------------------------------------------------------------
. * 1) Instalar parallel (si hace falta)
. *------------------------------------------------------------
. cap which parallel

. if _rc {
.     net install parallel, from(https://raw.github.com/gvegayon/parallel/master/) replace
.     * alternativa :
.         * ssc install parallel, replace
. }

. 
. *------------------------------------------------------------
. * 2) Setear clusters (en tu máquina 8-core: 8)
. *------------------------------------------------------------
. set processors 1
    The maximum number of processors or cores being used is changed from 2 to 1.  It can be set to any number between 1 and 2

. parallel setclusters 8, force
N Child processes: 8
Stata dir:  C:\Program Files\StataNow19/StataMP-64.exe

. 
. *------------------------------------------------------------
. * 3) Smoke test (pocas reps) para confirmar que corre
. *  Para la estimacion real poner aprox 600 reps para obtener aprox 500 replicas sin fallas; hay un % de fallas de aprox. 18%!.
. *  O incluso poner 900 para obtener aprox unas 750 reps sin fallas. 
. *------------------------------------------------------------
. parallel bs, ///
>     expression( diff1 = r(diff1) diff2 = r(diff2) diff3 = r(diff3) ) ///
>     reps(1000)  cluster(correlativo) strata(macro_sector) : ///
>     ipwra_diff_manu_serv, dvar(D_pp_ignore) yvar(Y_cond) sector(macro_sector) ///
>         xtr("`XTR0'") xy("`XY0'") vcetype(robust) 
