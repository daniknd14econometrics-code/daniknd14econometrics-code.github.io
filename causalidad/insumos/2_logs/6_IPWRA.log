. ****************************************************************************
. 
. **# SECTORES
. 
. 
.                                            
.                                   
. *============================================================
. * IPWRA por macro_sector y diferencias (DIAGONALES) - point estimates
. *============================================================
. 
. local D   D_pp_ignore

. local Y   Y_cond

. 
. local XTR0 "edad capital_extranjero share_prof_tecn exp_dummy ln_tpo_mean  indice_redes                   redesXexp redesXsize"

. local XY0  "edad capital_extranjero share_prof_tecn exp_dummy ln_tpo_mean  indice_redes ln_tpo_sq edad_sq redesXexp redesXsize org1 org_miss"

. 
. local P0_FLOOR        = 1e-8

. local P0_TREAT_FLOOR  = 1e-8

. local W_CEIL          = 1e6

. local PS_TRIM_ON = 1

. local PS0_LOW    = 0.05

. local PS0_HIGH   = 0.95

. local WTRIM      "OFF" // o DROP

. local W_CAP_Q    = . // o 0.99 por ejemplo.

. 
. tempname a1m a2m a3m a1s a2s a3s

. scalar `a1m' = .

. scalar `a2m' = .

. scalar `a3m' = .

. scalar `a1s' = .

. scalar `a2s' = .

. scalar `a3s' = .

. 
. foreach s in 1 2 {
  2. 
.     preserve
  3.         keep if macro_sector==`s'
  4.         keep if inlist(`D',0,1,2,3)
  5.         drop if missing(`Y')
  6. 
.         * dropear missings en unión de covariables  (NO en una sola línea con llaves)
.         foreach x of local XTR0 {
  7.             drop if missing(`x')
  8.         }
  9.         foreach x of local XY0 {
 10.             drop if missing(`x')
 11.         }
 12. 
.         quietly mlogit `D' `XTR0', baseoutcome(0) nolog
 13.         cap drop p0 p1 p2 p3
 14.         predict double p0, outcome(0)
 15.         predict double p1, outcome(1)
 16.         predict double p2, outcome(2)
 17.         predict double p3, outcome(3)
 18. 
.         tempvar use_final w1 w2 w3
 19.         gen byte `use_final' = 1
 20. 
.         replace `use_final' = 0 if missing(p0)
 21.         replace `use_final' = 0 if (`D'==0            & p0<=`P0_FLOOR')
 22.         replace `use_final' = 0 if (inlist(`D',1,2,3) & p0<=`P0_TREAT_FLOOR')
 23. 
.         if (`PS_TRIM_ON'==1) {
 24.             replace `use_final' = 0 if (p0<`PS0_LOW' | p0>`PS0_HIGH')
 25.         }
 26. 
.         gen double `w1' = .
 27.         gen double `w2' = .
 28.         gen double `w3' = .
 29.         replace `w1' = (p1/p0) if `D'==0 & `use_final'==1
 30.         replace `w2' = (p2/p0) if `D'==0 & `use_final'==1
 31.         replace `w3' = (p3/p0) if `D'==0 & `use_final'==1
 32. 
.         replace `use_final' = 0 if `D'==0 & `use_final'==1 & (missing(`w1') | `w1'<=0 | `w1'>`W_CEIL')
 33.         replace `use_final' = 0 if `D'==0 & `use_final'==1 & (missing(`w2') | `w2'<=0 | `w2'>`W_CEIL')
 34.         replace `use_final' = 0 if `D'==0 & `use_final'==1 & (missing(`w3') | `w3'<=0 | `w3'>`W_CEIL')
 35. 
.         if (upper("`WTRIM'")=="DROP") {
 36.             local pct = 100*`W_CAP_Q'
 37.             quietly count if `D'==0 & `use_final'==1
 38.             if (r(N)>0) {
 39.                 quietly centile `w1' if `D'==0 & `use_final'==1, centile(`pct')
 40.                 local wcap1 = r(c_1)
 41.                 quietly centile `w2' if `D'==0 & `use_final'==1, centile(`pct')
 42.                 local wcap2 = r(c_1)
 43.                 quietly centile `w3' if `D'==0 & `use_final'==1, centile(`pct')
 44.                 local wcap3 = r(c_1)
 45. 
.                 if (`wcap1'<. & `wcap1'>0) replace `use_final' = 0 if `D'==0 & `use_final'==1 & `w1' > `wcap1'
 46.                 if (`wcap2'<. & `wcap2'>0) replace `use_final' = 0 if `D'==0 & `use_final'==1 & `w2' > `wcap2'
 47.                 if (`wcap3'<. & `wcap3'>0) replace `use_final' = 0 if `D'==0 & `use_final'==1 & `w3' > `wcap3'
 48.             }
 49.         }
 50. 
.         keep if `use_final'==1
 51.                 
.                         * tablas descriptivas en misma muestra que las estimaciones por sectores
.                 summarize  Y_cond i.D_pp_ignore edad capital_extranjero share_prof_tecn exp_dummy ln_tpo_mean indice_redes ///
>                                                                                                 ln_tpo_sq edad_sq redesXexp redesXsize ///
>                                                                                   org1 org_miss if `s'==1
 52.                 summarize  Y_cond i.D_pp_ignore edad capital_extranjero share_prof_tecn exp_dummy ln_tpo_mean indice_redes ///
>                                                                                                 ln_tpo_sq edad_sq redesXexp redesXsize ///
>                                                                                   org1 org_miss if `s'==2
 53.         drop `use_final' `w1' `w2' `w3'
 54. 
.         tempname b V
 55.         forvalues t=1/3 {
 56. 
.             quietly count if `D'==`t'
 57.             local Nt = r(N)
 58.             quietly count if `D'==0
 59.             local N0 = r(N)
 60.             if (`Nt'==0 | `N0'==0) continue
 61.                 
.         *osample(`__osname') pstolerance(`=P0_FLOOR') vce(cluster correlativo)
.         teffects ipwra ///
>                 (`Y' `XY0', logit) ///
>                 (`D' `XTR0', mlogit), ///
>                 atet control(0) tlevel(`t') 
 62. 
.             if (_rc==0 & e(converged)==1) {
 63.                 matrix `b' = e(b)
 64.                 matrix `V' = e(V)
 65.                                 local cn : colfullnames `b'
 66. 
.                                 * Lista de columnas ATET (en orden k=1,2,3)
.                                 local atetcols ""
 67.                                 foreach nm of local cn {
 68.                                         if (substr("`nm'",1,5)=="ATET:") local atetcols "`atetcols' `nm'"
 69.                                 }
 70.                                 * Columna diagonal: k=t  (t-ésimo ATET)
.                                 local diagcol : word `t' of `atetcols'
 71. 
.                                 scalar __atet = el(`b', 1, colnumb(`b', "`diagcol'"))
 72. 
.                 if (`s'==1 & `t'==1) scalar `a1m' = __atet
 73.                 if (`s'==1 & `t'==2) scalar `a2m' = __atet
 74.                 if (`s'==1 & `t'==3) scalar `a3m' = __atet
 75.                 if (`s'==2 & `t'==1) scalar `a1s' = __atet
 76.                 if (`s'==2 & `t'==2) scalar `a2s' = __atet
 77.                 if (`s'==2 & `t'==3) scalar `a3s' = __atet
 78.             }
 79.         }
 80. 
.     restore
 81. }
