. *********************************************************************************
. *====================================================================
. * (A) DISEÑO FIJO (UNA SOLA VEZ): construir y guardar base recortada
. *====================================================================
. 
. * Requiere que ya existan:
. *   - macro_sector (1=manuf, 2=serv)
. *   - D_pp_ignore (0/1/2/3)
. *   - Y_cond
. *   - covariables en XTR0 y XY0 (incluye ln_tpo_sq, edad_sq, redesXexp, redesXsize, etc.)
. 
. local D   D_pp_ignore

. local Y   Y_cond

. 
. * Listas (las tuyas)
. local XTR0 "edad capital_extranjero share_prof_tecn exp_dummy ln_tpo_mean indice_redes                   redesXexp redesXsize"

. local XY0  "edad capital_extranjero share_prof_tecn exp_dummy ln_tpo_mean indice_redes ln_tpo_sq edad_sq redesXexp redesXsize org1 org_miss"

. 
. * Umbrales (los tuyos)
. local P0_FLOOR        = 1e-8

. local P0_TREAT_FLOOR  = 1e-8

. local W_CEIL          = 1e6

. local PS_TRIM_ON = 1

. local PS0_LOW    = 0.05

. local PS0_HIGH   = 0.95

. local WTRIM      "OFF" // o DROP

. local W_CAP_Q    = . // o 0.99 por ejemplo.

. 
. * ID de observación para "marcar" qué filas entran en la muestra fija
. gen long __obsid = _n

. gen byte __keep_design = 0

. 
. tempfile __keepids

. 
. foreach s in 1 2 {
  2. 
.     preserve
  3.         keep if macro_sector==`s'
  4.         keep if inlist(`D',0,1,2,3)
  5.         drop if missing(`Y')
  6. 
.         * Drop missings en unión de covariables
.         foreach x of local XTR0 {
  7.             drop if missing(`x')
  8.         }
  9.         foreach x of local XY0 {
 10.             drop if missing(`x')
 11.         }
 12. 
.         * mlogit para p0..p3 (solo para definir muestra)
.         quietly mlogit `D' `XTR0', baseoutcome(0) nolog
 13. 
.         capture drop p0 p1 p2 p3
 14.         quietly predict double p0, outcome(0)
 15.         quietly predict double p1, outcome(1)
 16.         quietly predict double p2, outcome(2)
 17.         quietly predict double p3, outcome(3)
 18. 
.         tempvar use_final w1 w2 w3
 19.         gen byte `use_final' = 1
 20. 
.         * Floors sobre p0
.         replace `use_final' = 0 if missing(p0)
 21.         replace `use_final' = 0 if (`D'==0            & p0<=`P0_FLOOR')
 22.         replace `use_final' = 0 if (inlist(`D',1,2,3) & p0<=`P0_TREAT_FLOOR')
 23. 
.         * PS-trim sobre p0
.         if (`PS_TRIM_ON'==1) {
 24.             replace `use_final' = 0 if (p0<`PS0_LOW' | p0>`PS0_HIGH')
 25.         }
 26. 
.         * wceil en controles para cada t
.         gen double `w1' = .
 27.         gen double `w2' = .
 28.         gen double `w3' = .
 29.         replace `w1' = (p1/p0) if `D'==0 & `use_final'==1
 30.         replace `w2' = (p2/p0) if `D'==0 & `use_final'==1
 31.         replace `w3' = (p3/p0) if `D'==0 & `use_final'==1
 32. 
.         replace `use_final' = 0 if `D'==0 & `use_final'==1 & (missing(`w1') | `w1'<=0 | `w1'>`W_CEIL')
 33.         replace `use_final' = 0 if `D'==0 & `use_final'==1 & (missing(`w2') | `w2'<=0 | `w2'>`W_CEIL')
 34.         replace `use_final' = 0 if `D'==0 & `use_final'==1 & (missing(`w3') | `w3'<=0 | `w3'>`W_CEIL')
 35. 
.         * DROP por cuantil (solo controles) si corresponde
.         if (upper("`WTRIM'")=="DROP") {
 36.             local pct = 100*`W_CAP_Q'
 37.             quietly count if `D'==0 & `use_final'==1
 38.             if (r(N)>0) {
 39.                 quietly centile `w1' if `D'==0 & `use_final'==1, centile(`pct')
 40.                 local wcap1 = r(c_1)
 41.                 quietly centile `w2' if `D'==0 & `use_final'==1, centile(`pct')
 42.                 local wcap2 = r(c_1)
 43.                 quietly centile `w3' if `D'==0 & `use_final'==1, centile(`pct')
 44.                 local wcap3 = r(c_1)
 45. 
.                 if (`wcap1'<. & `wcap1'>0) replace `use_final' = 0 if `D'==0 & `use_final'==1 & `w1' > `wcap1'
 46.                 if (`wcap2'<. & `wcap2'>0) replace `use_final' = 0 if `D'==0 & `use_final'==1 & `w2' > `wcap2'
 47.                 if (`wcap3'<. & `wcap3'>0) replace `use_final' = 0 if `D'==0 & `use_final'==1 & `w3' > `wcap3'
 48.             }
 49.         }
 50. 
.         keep if `use_final'==1
 51.         keep __obsid
 52.         save `__keepids', replace
 53.     restore
 54. 
.     * Marcar en la base completa
.         merge 1:1 __obsid using `__keepids', keep(master match)
 55.         replace __keep_design = 1 if _merge==3
 56.         drop _merge
 57. }
