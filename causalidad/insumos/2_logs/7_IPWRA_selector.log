. *========================
. * 6) Programa: evalúa diseño (mlogit) y métricas por tlevel
. *========================
. cap program drop eval_design

. program define eval_design
  1.     version 19.0
  2.     syntax , HANDLE(name) DVAR(name) XLIST(string asis) MODE(string) SPEC(string)
  3. 
.     *--- Guardar dataset original (para dejar todo como estaba al salir)
.     tempfile __orig __work
  4.     quietly save `__orig', replace
  5. 
.     *--- Trabajar en una copia (sin preserve)
.     keep if inlist(`dvar',0,1,2,3)
  6. 
.     * --- sanitizar xlist: sacar comillas y normalizar espacios ---
.     local xvars `"`xlist'"'
  7.     local xvars : subinstr local xvars `"""' "", all
  8.     local xvars = ustrregexra("`xvars'", "[[:space:]]+", " ")
  9.     local xvars = itrim(trim("`xvars'"))
 10. 
.     * --- limpiar covariables 100% missing / inexistentes ---
.     local xkeep ""
 11.     foreach x of local xvars {
 12.         capture confirm variable `x'
 13.         if (_rc) continue
 14. 
.         quietly count if !missing(`x')
 15.         if (r(N)>0) local xkeep "`xkeep' `x'"
 16.         else di as error "Mode=`mode' Spec=`spec': covariable `x' es TODO missing -> la saco."
 17.     }
 18. 
.     local xkeep : list retokenize xkeep
 19.     if ("`xkeep'"=="") {
 20.         di as error "Mode=`mode' Spec=`spec': X quedó vacío (no hay covariables con datos) -> salteo."
 21.         use `__orig', clear
 22.         exit
 23.     }
 24. 
.     * Listwise deletion sobre X usable
.     egen byte __missX = rowmiss(`xkeep')
 25.     drop if __missX>0
 26.     drop __missX
 27. 
.     quietly count
 28.     local N_used = r(N)
 29.     if (`N_used' < ${MIN_N_USED}) {
 30.         di as error "Muy poca muestra para Mode=`mode' Spec=`spec' (N=`N_used'). Salteo."
 31.         use `__orig', clear
 32.         exit
 33.     }
 34. 
.     local xvars "`xkeep'"
 35. 
.     * Estimar mlogit del tratamiento
.     quietly capture mlogit `dvar' `xvars', baseoutcome(0) nolog
 36.     if (_rc) {
 37.         di as error "FALLÓ mlogit para Mode=`mode' Spec=`spec' (separación/colinealidad/celdas vacías)."
 38.         use `__orig', clear
 39.         exit
 40.     }
 41. 
.     tempvar p0 p1 p2 p3
 42.     quietly predict double `p0', outcome(0)
 43.     quietly predict double `p1', outcome(1)
 44.     quietly predict double `p2', outcome(2)
 45.     quietly predict double `p3', outcome(3)
 46. 
.     * Guardar dataset de trabajo (ya con p0..p3)
.     quietly save `__work', replace
 47.         
.         * check
.     * (debug desactivado)
.     * summ `p0' if `dvar'==0, detail
.     * summ `p`t'' if `dvar'==0, detail
.     * summ `w' if `dvar'==0, detail
.     * di as result "N0=`N0'  sumw=`sumw'  sumw2=`sumw2'  ESS0=`ESS0'"
.     * Loop por comparación (t vs 0) sin preserve
.     forvalues t = 1/3 {
 48.         use `__work', clear
 49.         keep if inlist(`dvar',0,`t')
 50. 
.         tempvar w w2 bad_w
 51.         gen double `w' = .
 52.         replace `w' = 1 if `dvar'==`t'
 53.         replace `w' = (`p`t''/`p0') if `dvar'==0
 54. 
.         gen byte `bad_w' = (`dvar'==0 & (`p0'<=${P0_FLOOR} | missing(`w') | `w'>${W_CEIL}))
 55.         drop if `bad_w'==1
 56. 
.         quietly count if `dvar'==`t'
 57.         local N1 = r(N)
 58.         quietly count if `dvar'==0
 59.         local N0 = r(N)
 60. 
.         * ESS0
.         quietly summarize `w' if `dvar'==0, meanonly
 61.         local sumw = r(sum)
 62.         gen double `w2' = `w'^2 if `dvar'==0
 63.         quietly summarize `w2' if `dvar'==0, meanonly
 64.         local sumw2 = r(sum)
 65.         local ESS0 = .
 66.         if (`sumw2' > 0 & `sumw2' < .) local ESS0 = (`sumw'^2)/`sumw2'
 67. 
.         * Concentración de pesos
.         quietly summarize `w' if `dvar'==0, detail
 68.         local w_p95 = r(p95)
 69.         local w_p99 = r(p99)
 70.         local w_max = r(max)
 71. 
.         * Balance
.         local maxSMD = 0
 72.         local sumAbs = 0
 73.         local k = 0
 74.         local maxLogVR = 0
 75. 
.         foreach x of local xvars {
 76.             quietly summarize `x' if `dvar'==`t'
 77.             local mt = r(mean)
 78.             local vt = r(Var)
 79. 
.             quietly summarize `x' [aw=`w'] if `dvar'==0
 80.             local mc = r(mean)
 81.             local vc = r(Var)
 82. 
.             local sdpool = .
 83.             if (`vt' < . & `vc' < .) local sdpool = sqrt((`vt' + `vc')/2)
 84. 
.             if (`sdpool' > 0 & `sdpool' < .) {
 85.                 local smd = (`mt' - `mc')/`sdpool'
 86.                 local abssmd = abs(`smd')
 87.                 if (`abssmd' > `maxSMD') local maxSMD = `abssmd'
 88.                 local sumAbs = `sumAbs' + `abssmd'
 89.                 local ++k
 90. 
.                 if (`vt' > 0 & `vc' > 0 & `vt' < . & `vc' < .) {
 91.                     local logvr = abs(log(`vc'/`vt'))
 92.                     if (`logvr' > `maxLogVR') local maxLogVR = `logvr'
 93.                 }
 94.             }
 95.         }
 96. 
.         local meanSMD = .
 97.         if (`k' > 0) local meanSMD = `sumAbs'/`k'
 98.                 
.                 
.         post `handle' ("`mode'") ("`spec'") (`t') (`N1') (`N0') (`ESS0') ///
>             (`maxSMD') (`meanSMD') (`maxLogVR') (`w_p95') (`w_p99') (`w_max') (`N_used') 
 99.     }
100. 
.     * Volver a como estaba el dataset original
.     use `__orig', clear
101. end

. 
. 
. 
. 
. *========================
. * 6B) Programa: evalúa diseño con pesos ATET tipo teffects (comparables con ipwra)
. *     Idea: para cada comparación (t vs 0), los pesos de controles son w = p_t/p_0
. *     (y los tratados t tienen peso 1). Esto replica la lógica de ATET por IPW
. *     que usa teffects; además, normalizamos w en controles para que mean(w|D=0)=1
. *     cuando computamos percentiles/max de pesos (comparabilidad entre specs).
. *========================
. cap program drop eval_design_tew

. program define eval_design_tew
  1.     version 19.0
  2.     syntax , HANDLE(name) DVAR(name) XLIST(string asis) MODE(string) SPEC(string)
  3. 
.     *--- Guardar dataset original (para dejar todo como estaba al salir)
.     tempfile __orig __work
  4.     quietly save `__orig', replace
  5. 
.     *--- Trabajar en una copia (sin preserve)
.     keep if inlist(`dvar',0,1,2,3)
  6. 
.     * --- sanitizar xlist: sacar comillas y normalizar espacios ---
.     local xvars `"`xlist'"'
  7.     local xvars : subinstr local xvars `"""' "", all
  8.     local xvars = ustrregexra("`xvars'", "[[:space:]]+", " ")
  9.     local xvars = itrim(trim("`xvars'"))
 10. 
.     * --- limpiar covariables 100% missing / inexistentes ---
.     local xkeep ""
 11.     foreach x of local xvars {
 12.         capture confirm variable `x'
 13.         if (_rc) continue
 14. 
.         quietly count if !missing(`x')
 15.         if (r(N)>0) local xkeep "`xkeep' `x'"
 16.         else di as error "Mode=`mode' Spec=`spec': covariable `x' es TODO missing -> la saco."
 17.     }
 18. 
.     local xkeep : list retokenize xkeep
 19.     if ("`xkeep'"=="") {
 20.         di as error "Mode=`mode' Spec=`spec': X quedó vacío (no hay covariables con datos) -> salteo."
 21.         use `__orig', clear
 22.         exit
 23.     }
 24. 
.     * Listwise deletion sobre X usable (alineado con teffects)
.     egen byte __missX = rowmiss(`xkeep')
 25.     drop if __missX>0
 26.     drop __missX
 27. 
.     quietly count
 28.     local N_used = r(N)
 29.     if (`N_used' < ${MIN_N_USED}) {
 30.         di as error "Muy poca muestra para Mode=`mode' Spec=`spec' (N=`N_used'). Salteo."
 31.         use `__orig', clear
 32.         exit
 33.     }
 34. 
.     local xvars "`xkeep'"
 35. 
.     * Estimar mlogit del tratamiento (mismo diseño que la corrida final multivaluada)
.     quietly capture mlogit `dvar' `xvars', baseoutcome(0) nolog
 36.     if (_rc) {
 37.         di as error "FALLÓ mlogit para Mode=`mode' Spec=`spec' (separación/colinealidad/celdas vacías)."
 38.         use `__orig', clear
 39.         exit
 40.     }
 41. 
.     tempvar p0 p1 p2 p3
 42.     quietly predict double `p0', outcome(0)
 43.     quietly predict double `p1', outcome(1)
 44.     quietly predict double `p2', outcome(2)
 45.     quietly predict double `p3', outcome(3)
 46. 
.     * Guardar dataset de trabajo (ya con p0..p3)
.     quietly save `__work', replace
 47. 
.     local WTRIM = upper("${W_TRIM_STYLE}")
 48.     local do_ps_trim = ${PS_TRIM}
 49.     local ps_low  = ${PS0_LOW}
 50.     local ps_high = ${PS0_HIGH}
 51. 
.     * Loop por comparación (t vs 0)
.     forvalues t = 1/3 {
 52.         use `__work', clear
 53.         keep if inlist(`dvar',0,`t')
 54. 
.         * Tamaños antes de recortes (para reportar shares)
.         quietly count if `dvar'==`t'
 55.         local N1_init = r(N)
 56.         quietly count if `dvar'==0
 57.         local N0_init = r(N)
 58. 
.         tempvar w_raw w w2 flag_p0_ctrl flag_p0_tr flag_ps flag_wceil
 59. 
.         * Reglas explícitas de overlap (p0=Pr(D=0|X))
.         gen byte `flag_p0_ctrl' = (`p0'<=${P0_FLOOR} | missing(`p0')) if `dvar'==0
 60.         gen byte `flag_p0_tr'   = (`p0'<=${P0_TREAT_FLOOR} | missing(`p0')) if `dvar'==`t'
 61. 
.         gen byte `flag_ps' = 0
 62.         if (`do_ps_trim'==1) {
 63.             replace `flag_ps' = (`p0'<`ps_low' | `p0'>`ps_high') if inlist(`dvar',0,`t')
 64.         }
 65. 
.         quietly count if `dvar'==0 & `flag_p0_ctrl'==1
 66.         local drop_p0_ctrl = r(N)
 67.         quietly count if `dvar'==`t' & `flag_p0_tr'==1
 68.         local drop_p0_tr   = r(N)
 69.         quietly count if `flag_ps'==1
 70.         local drop_ps_all  = r(N)
 71. 
.         drop if (`dvar'==0 & `flag_p0_ctrl'==1) | (`dvar'==`t' & `flag_p0_tr'==1) | (`flag_ps'==1)
 72. 
.         * Pesos tipo ATET(t vs 0):
.         *   tratados (D=t): 1
.         *   controles (D=0): p_t / p_0
.         gen double `w_raw' = .
 73.         replace `w_raw' = 1 if `dvar'==`t'
 74.         replace `w_raw' = (`p`t''/`p0') if `dvar'==0
 75. 
.         * Corte duro de seguridad (explosión numérica / indefinido)
.         gen byte `flag_wceil' = (`dvar'==0 & (missing(`w_raw') | `w_raw'<=0 | `w_raw'>${W_CEIL}))
 76.         quietly count if `flag_wceil'==1
 77.         local drop_wceil = r(N)
 78.         drop if `flag_wceil'==1
 79. 
.         * --- Trimming por cuantiles (controles): CAP (winsorizar) o DROP (eliminar) ---
.         local w_cap = .
 80.         local share_trim = .
 81.         quietly count if `dvar'==0
 82.         local N0_for_trim = r(N)
 83. 
.         if (`N0_for_trim' > 0 & ${W_CAP_Q} < .) {
 84.             local pct = 100*${W_CAP_Q}
 85.             quietly centile `w_raw' if `dvar'==0, centile(`pct')
 86.             local w_cap = r(c_1)
 87. 
.             if (`w_cap' < . & `w_cap' > 0) {
 88.                 quietly count if `dvar'==0 & `w_raw' > `w_cap'
 89.                 local n_trim = r(N)
 90.                 local share_trim = `n_trim'/`N0_for_trim'
 91. 
.                 if ("`WTRIM'"=="CAP") {
 92.                     replace `w_raw' = `w_cap' if `dvar'==0 & `w_raw' > `w_cap'
 93.                 }
 94.                 else if ("`WTRIM'"=="DROP") {
 95.                     drop if `dvar'==0 & `w_raw' > `w_cap'
 96.                 }
 97.             }
 98.         }
 99. 
.         * Normalizar solo controles para reportar percentiles/máximo comparables:
.         * mean(w|D=0)=1  (SMD/VR/ESS son invariantes a escala, pero p99/max no)
.         gen double `w' = `w_raw'
100.         quietly summarize `w' if `dvar'==0, meanonly
101.         local mw0 = r(mean)
102.         if (`mw0' > 0 & `mw0' < .) {
103.             replace `w' = `w_raw'/`mw0' if `dvar'==0
104.         }
105. 
.         quietly count if `dvar'==`t'
106.         local N1 = r(N)
107.         quietly count if `dvar'==0
108.         local N0 = r(N)
109. 
.         * ESS0 (solo controles; invariante a escala)
.         quietly summarize `w' if `dvar'==0, meanonly
110.         local sumw = r(sum)
111. 
.         gen double `w2' = `w'^2 if `dvar'==0
112.         quietly summarize `w2' if `dvar'==0, meanonly
113.         local sumw2 = r(sum)
114. 
.         local ESS0 = .
115.         if (`sumw2' > 0 & `sumw2' < .) local ESS0 = (`sumw'^2)/`sumw2'
116. 
.         * Concentración de pesos (controles; ya normalizados)
.         quietly summarize `w' if `dvar'==0, detail
117.         local w_p95 = r(p95)
118.         local w_p99 = r(p99)
119.         local w_max = r(max)
120. 
.         * Overlap (rangos de p0)
.         quietly summarize `p0' if `dvar'==`t', detail
121.         local p0_t_min = r(min)
122.         local p0_t_max = r(max)
123.         quietly summarize `p0' if `dvar'==0, detail
124.         local p0_0_min = r(min)
125.         local p0_0_max = r(max)
126. 
.         * Balance: SMD y ratio de varianzas (en log abs)
.         local maxSMD = 0
127.         local sumAbs = 0
128.         local k = 0
129.         local maxLogVR = 0
130.                 
.                 local maxAbsVar ""
131.                 local maxLogVRVar ""
132. 
.                 foreach x of local xvars {
133.                         quietly summarize `x' if `dvar'==`t'
134.                         local mt = r(mean)
135.                         local vt = r(Var)
136. 
.                         quietly summarize `x' [iw=`w'] if `dvar'==0
137.                         local mc = r(mean)
138.                         local vc = r(Var)
139. 
.                         local sdpool = .
140.                         if (`vt' < . & `vc' < .) local sdpool = sqrt((`vt' + `vc')/2)
141. 
.                         if (`sdpool' > 0 & `sdpool' < .) {
142.                                 local smd    = (`mt' - `mc')/`sdpool'
143.                                 local abssmd = abs(`smd')
144. 
.                                 if (`abssmd' > `maxSMD') {
145.                                         local maxSMD    = `abssmd'
146.                                         local maxAbsVar "`x'"
147.                                 }
148. 
.                                 local sumAbs = `sumAbs' + `abssmd'
149.                                 local ++k
150. 
.                                 if (`vt' > 0 & `vc' > 0 & `vt' < . & `vc' < .) {
151.                                         local logvr = abs(log(`vc'/`vt'))
152.                                         if (`logvr' > `maxLogVR') {
153.                                                 local maxLogVR    = `logvr'
154.                                                 local maxLogVRVar "`x'"
155.                                         }
156.                                 }
157.                         }
158.                 }
159. 
.         local meanSMD = .
160.         if (`k' > 0) local meanSMD = `sumAbs'/`k'
161. 
.                 local col_wsd "`maxAbsVar'"
162.         local col_wvr "`maxLogVRVar'"
163.                 
.         local share_drop_p0_ctrl = cond(`N0_init'>0, `drop_p0_ctrl'/`N0_init', .)
164.         local share_drop_p0_tr   = cond(`N1_init'>0, `drop_p0_tr'/`N1_init', .)
165.         local share_drop_ps      = cond((`N0_init'+`N1_init')>0, `drop_ps_all'/(`N0_init'+`N1_init'), .)
166.         local share_drop_wceil   = cond((`N0_init'+`N1_init')>0, `drop_wceil'/(`N0_init'+`N1_init'), .)
167. 
.         post `handle' ("`mode'") ("`spec'") (`t') ///
>             (`N1') (`N0') (`ESS0') ///
>             (`maxSMD') (`meanSMD') (`maxLogVR') ///
>             (`w_p95') (`w_p99') (`w_max') (`N_used') ///
>             (`w_cap') (`share_trim') (`share_drop_p0_ctrl') (`share_drop_p0_tr') (`share_drop_ps') (`share_drop_wceil') ///
>             (`p0_t_min') (`p0_t_max') (`p0_0_min') (`p0_0_max')  ("`col_wsd'") ("`col_wvr'")
168.     }
169. 
.     * Volver a como estaba el dataset original
.     use `__orig', clear
170. end

. 
. 
. *----------------------------
. *----------------------------
. * 4) Evaluación "benchmark" (MULTINOMIAL) para balance del diseño IPWRA
. *
. * IDEA (alineada con el manual .tex):
. *   - Como D es multi-valued (0,1,2,3), el modelo correcto de propensión es MULTINOMIAL (mlogit).
. *   - Estimamos una sola vez p_j(X)=Pr(D=j|X) con baseoutcome(0) usando X del treatment model (XTR).
. *   - Para cada contraste t vs 0 (t=1,2,3), armamos pesos ATET en controles:
. *         w0_i = p_t(X_i) / p_0(X_i)     si D_i=0
. *         w1_i = 1                      si D_i=t
. *     (Luego normalizamos w0 para que E[w0|D=0]=1; esto NO cambia SMD ni el ATET tipo Hájek.)
. *   - Calculamos métricas de balance sobre el set UNION(XTR, XY) para reflejar el diseño IPWRA,
. *
. *----------------------------
. 
. capture program drop eval_design_teb

. program define eval_design_teb
  1.     version 19.0
  2.     syntax , HANDLE(name) DVAR(name) XTR(string asis) XY(string asis) MODE(string) SPEC(string)
  3. 
.     tempfile __orig __work
  4.     quietly save `__orig', replace
  5. 
.     keep if inlist(`dvar',0,1,2,3)
  6. 
.     *----------------------------
.     * 4.1) Sanitizar listas + filtrar covariables "vacías"
.     *----------------------------
.     local xtrvars `"`xtr'"'
  7.     local xyvars  `"`xy'"'
  8. 
.     local xtrvars : subinstr local xtrvars `"""' "" , all
  9.     local xyvars  : subinstr local xyvars  `"""' "" , all
 10. 
.     local xtrvars = ustrregexra("`xtrvars'", "[[:space:]]+", " ")
 11.     local xyvars  = ustrregexra("`xyvars'",  "[[:space:]]+", " ")
 12.     local xtrvars = itrim(trim("`xtrvars'"))
 13.     local xyvars  = itrim(trim("`xyvars'"))
 14. 
.     local xtr_keep ""
 15.     foreach x of local xtrvars {
 16.         capture confirm variable `x'
 17.         if (_rc) continue
 18.         quietly count if !missing(`x')
 19.         if (r(N)>0) local xtr_keep "`xtr_keep' `x'"
 20.         else di as error "Mode=`mode' Spec=`spec': covariable (XTR) `x' es TODO missing -> la saco."
 21.     }
 22. 
.     local xy_keep ""
 23.     foreach x of local xyvars {
 24.         capture confirm variable `x'
 25.         if (_rc) continue
 26.         quietly count if !missing(`x')
 27.         if (r(N)>0) local xy_keep "`xy_keep' `x'"
 28.         else di as error "Mode=`mode' Spec=`spec': covariable (XY) `x' es TODO missing -> la saco."
 29.     }
 30. 
.     local xtr_keep : list retokenize xtr_keep
 31.     local xy_keep  : list retokenize xy_keep
 32. 
.     if ("`xtr_keep'"=="") {
 33.         di as error "Mode=`mode' Spec=`spec': XTR quedó vacío -> salteo benchmark."
 34.         forvalues t=1/3 {
 35.             quietly count if `dvar'==`t'
 36.             local N1 = r(N)
 37.             quietly count if `dvar'==0
 38.             local N0 = r(N)
 39.             post `handle' ("`mode'") ("`spec'") (`t') (`N1') (`N0') (.) (.) (.) (.) (.) (.) (.) ///
>                 (`N1'+`N0') (.) (.) (.) (.) (.) (.) (.) (0) ("") ("")
 40.         }
 41.         use `__orig', clear
 42.         exit
 43.     }
 44. 
.     * UNION(XTR,XY) para balance (IPWRA permite X distintos en TM y YM)
.     local x_all "`xtr_keep' `xy_keep'"
 45.     local x_all : list uniq x_all
 46. 
.     * Listwise deletion en X_all (alineado con lo que haría teffects en práctica)
.         * Primera diferencia importante con el programa anterior: impone una muestra mas exigente porque si hay variables solo en el modelo para Y que tienen mucho
>  missing, elimina estas observaciones.
.         * Luego el modelo multinomial para el tratamiento lo estima sobre esta muestra resultante, mas exigente.
.         
.     egen byte __missX = rowmiss(`x_all')
 47.     drop if __missX>0
 48.     drop __missX
 49. 
.     quietly count
 50.     local N_used0 = r(N)
 51.     if (`N_used0' < ${MIN_N_USED}) {
 52.         di as error "Muy poca muestra para Mode=`mode' Spec=`spec' (N=`N_used0'). Salteo benchmark."
 53.         forvalues t=1/3 {
 54.             quietly count if `dvar'==`t'
 55.             local N1 = r(N)
 56.             quietly count if `dvar'==0
 57.             local N0 = r(N)
 58.             post `handle' ("`mode'") ("`spec'") (`t') (`N1') (`N0') (.) (.) (.) (.) (.) (.) (.) ///
>                 (`N1'+`N0') (.) (.) (.) (.) (.) (.) (.) (0) ("") ("")
 59.         }
 60.         use `__orig', clear
 61.         exit
 62.     }
 63. 
.     *----------------------------
.     * 4.2) Propensiones MULTINOMIALES (mlogit) – tratamiento model
.     *----------------------------
.     quietly capture mlogit `dvar' `xtr_keep', baseoutcome(0) nolog
 64.     if (_rc) {
 65.         di as error "Mode=`mode' Spec=`spec': FALLÓ mlogit (multinomial) del tratamiento."
 66.         forvalues t=1/3 {
 67.             quietly count if `dvar'==`t'
 68.             local N1 = r(N)
 69.             quietly count if `dvar'==0
 70.             local N0 = r(N)
 71.             post `handle' ("`mode'") ("`spec'") (`t') (`N1') (`N0') (.) (.) (.) (.) (.) (.) (.) ///
>                 (`N1'+`N0') (.) (.) (.) (.) (.) (.) (.) (0) ("") ("")
 72.         }
 73.         use `__orig', clear
 74.         exit
 75.     }
 76. 
.     tempvar p0 p1 p2 p3
 77.     quietly predict double `p0', outcome(0)
 78.     quietly predict double `p1', outcome(1)
 79.     quietly predict double `p2', outcome(2)
 80.     quietly predict double `p3', outcome(3)
 81. 
.     quietly save `__work', replace
 82. 
.     local WTRIM = upper("${W_TRIM_STYLE}")
 83.     local do_ps_trim = ${PS_TRIM}
 84.     local ps_low  = ${PS0_LOW}
 85.     local ps_high = ${PS0_HIGH}
 86. 
.     *----------------------------
.     * 4.3) Para cada t vs 0: pesos ATET + métricas (ESS0/pesos/overlap)
.     *----------------------------
.     forvalues t=1/3 {
 87.         use `__work', clear
 88.         keep if inlist(`dvar',0,`t')
 89. 
.         quietly count if `dvar'==`t'
 90.         local N1_init = r(N)
 91.         quietly count if `dvar'==0
 92.         local N0_init = r(N)
 93.         local N_all_init = `N1_init' + `N0_init'
 94. 
.         tempvar w_raw w w2 bad_ctrl bad_tr bad_ps bad_wceil
 95.         gen byte `bad_ctrl' = (`dvar'==0 & (`p0'<=${P0_FLOOR} | missing(`p0')))
 96.         gen byte `bad_tr'   = (`dvar'==`t' & (`p0'<=${P0_TREAT_FLOOR} | missing(`p0')))
 97. 
.         gen byte `bad_ps' = 0
 98.         if (`do_ps_trim'==1) {
 99.             replace `bad_ps' = (`p0'<`ps_low' | `p0'>`ps_high') if inlist(`dvar',0,`t')
100.         }
101. 
.         drop if `bad_ctrl' | `bad_tr' | `bad_ps'
102. 
.         gen double `w_raw' = .
103.         replace `w_raw' = 1 if `dvar'==`t'
104.         replace `w_raw' = (`p`t''/`p0') if `dvar'==0
105. 
.         gen byte `bad_wceil' = (`dvar'==0 & (missing(`w_raw') | `w_raw'<=0 | `w_raw'>${W_CEIL}))
106.         drop if `bad_wceil'
107. 
.         * Trimming por cuantil (solo controles)
.         local w_cap = .
108.         quietly count if `dvar'==0
109.         local N0_for_trim = r(N)
110. 
.         if (`N0_for_trim' > 0 & ${W_CAP_Q} < .) {
111.             local pct = 100*${W_CAP_Q}
112.             quietly centile `w_raw' if `dvar'==0, centile(`pct')
113.             local w_cap = r(c_1)
114. 
.             if (`w_cap' < . & `w_cap' > 0) {
115.                 if ("`WTRIM'"=="CAP") {
116.                     replace `w_raw' = `w_cap' if `dvar'==0 & `w_raw' > `w_cap'
117.                 }
118.                 else if ("`WTRIM'"=="DROP") {
119.                     drop if `dvar'==0 & `w_raw' > `w_cap'
120.                 }
121.             }
122.         }
123. 
.         * Normalizar controles a media 1 (no cambia SMD/ATET tipo Hájek). Sirve para comparar pesos de diferentes especificaciones.
.         gen double `w' = `w_raw'
124.         quietly summarize `w' if `dvar'==0, meanonly
125.         local mw0 = r(mean)
126.         if (`mw0'>0 & `mw0'<.) replace `w' = `w_raw'/`mw0' if `dvar'==0
127. 
.         quietly count if `dvar'==`t'
128.         local N1 = r(N)
129.         quietly count if `dvar'==0 & `w' < .
130.         local N0 = r(N)
131.         local N_used = `N1' + `N0'
132. 
.         * Share "excluida" por overlap/trimming (sustituye osample())
.         local share_os_all = .
133.         local share_os_1 = .
134.         local share_os_0 = .
135.         if (`N_all_init'>0) local share_os_all = 1 - (`N_used'/`N_all_init')
136.         if (`N1_init'>0)   local share_os_1   = 1 - (`N1'/`N1_init')
137.         if (`N0_init'>0)   local share_os_0   = 1 - (`N0'/`N0_init')
138. 
.         * Estadísticos de pesos en controles
.         quietly summarize `w' if `dvar'==0, detail
139.         local w_p95 = r(p95)
140.         local w_p99 = r(p99)
141.         local w_max = r(max)
142. 
.         * ESS0 en controles: (sum w)^2 / sum(w^2)
.         quietly summarize `w' if `dvar'==0, meanonly
143.         local sumw = r(sum)
144.         gen double `w2' = `w'^2 if `dvar'==0
145.         quietly summarize `w2' if `dvar'==0, meanonly
146.         local sumw2 = r(sum)
147. 
.         local ESS0 = .
148.         if (`sumw2'>0 & `sumw2'<.) local ESS0 = (`sumw'^2)/`sumw2'
149. 
.         * Overlap: rango de p0 en tratados y controles (post-filtros)
.         quietly summarize `p0' if `dvar'==`t', detail
150.         local p0_t_min = r(min)
151.         local p0_t_max = r(max)
152. 
.         quietly summarize `p0' if `dvar'==0, detail
153.         local p0_0_min = r(min)
154.         local p0_0_max = r(max)
155. 
.         *----------------------------
.         * 4.4) Balance: SMD + max|log(VR)| sobre UNION(XTR,XY)
.         *----------------------------
.                 * 2SEGUNDA DIFERENCIA respecto al progrma anterior: ahora el balance lo ejecuta tambien para las covariables que pudieran formar parte solo del mod
> elo para Y. 
.                 * esto podria hacer que se castigue una especificacion por una variable en modelo Y que tenga pesimo SMD, pero si no forma parte del modelo de trat
> amiento, lo castiga igual. 
.                 * (Discutible decision!).
.                 
.         local xbal "`x_all'"
156. 
.         local k=0
157.         local sumAbs=0
158.         local maxAbs=-1
159.         local maxAbsVar ""
160.         local maxLogVR=-1
161.         local maxLogVRVar ""
162.         local has_vr=0
163. 
.         foreach x of local xbal {
164.             capture confirm variable `x'
165.             if (_rc) continue
166. 
.             quietly summarize `x' if `dvar'==`t'
167.             local m1=r(mean)
168.             local v1=r(Var)
169. 
.             * Controles: media ponderada
.             quietly summarize `x' [iw=`w'] if `dvar'==0
170.             local m0=r(mean)
171. 
.             * Controles: varianza ponderada (alineada con tebalance)
.             *   v0 = sum_i w_i (x_i - xbar_w)^2 / (sum_i w_i - 1)
.             tempvar __dev __wdev
172.             quietly gen double `__dev'  = (`x' - `m0')^2 if `dvar'==0 & `w' < . & !missing(`x')
173.             quietly gen double `__wdev' = `w' * `__dev'  if `dvar'==0 & `w' < . & !missing(`x')
174. 
.             quietly summarize `w' if `dvar'==0 & `w' < .
175.             local sumw = r(sum)
176. 
.             quietly summarize `__wdev' if `dvar'==0 & !missing(`__wdev')
177.             local sumwdev = r(sum)
178. 
.             local v0 = .
179.             if (`sumw' > 1) local v0 = `sumwdev' / (`sumw' - 1)
180. 
.             quietly drop `__dev' `__wdev'
181. 
.             local denom = sqrt((`v1'+`v0')/2)
182.             if (`denom'>0 & `denom'<.) {
183.                 local smd = (`m1' - `m0')/`denom'
184.                 local a = abs(`smd')
185.                 local k = `k' + 1
186.                 local sumAbs = `sumAbs' + `a'
187.                 if (`a' > `maxAbs') {
188.                     local maxAbs = `a'
189.                     local maxAbsVar "`x'"
190.                 }
191.             }
192. 
.             if (`v0'>0 & `v1'>0 & `v0'<. & `v1'<.) {
193.                 local lv = abs(log(`v1'/`v0'))   // equivalente a abs(log(VR))
194.                 if (`lv' > `maxLogVR') {
195.                     local maxLogVR = `lv'
196.                     local maxLogVRVar "`x'"
197.                 }
198.                 local has_vr = 1
199.             }
200.         }
201. 
.         local maxSMD_w = .
202.         local meanSMD_w = .
203.         local maxLogVarRatio_w = .
204.         local parse_ok = 0
205. 
.         if (`k' > 0) {
206.             local maxSMD_w  = `maxAbs'
207.             local meanSMD_w = `sumAbs'/`k'
208.             local parse_ok  = 1
209.         }
210.         if (`has_vr'==1) local maxLogVarRatio_w = `maxLogVR'
211.         local col_wsd "`maxAbsVar'"
212.         local col_wvr "`maxLogVRVar'"
213. 
.         post `handle' ("`mode'") ("`spec'") (`t') (`N1') (`N0') (`ESS0') ///
>             (`maxSMD_w') (`meanSMD_w') (`maxLogVarRatio_w') ///
>             (`w_p95') (`w_p99') (`w_max') (`N_used') ///
>             (`p0_t_min') (`p0_t_max') (`p0_0_min') (`p0_0_max') ///
>             (`share_os_all') (`share_os_1') (`share_os_0') (`parse_ok') ("`col_wsd'") ("`col_wvr'")
214.     }
215. 
.     use `__orig', clear
216. end

. 
. 
. 
