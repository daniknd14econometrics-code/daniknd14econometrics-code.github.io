.             *============================================================
.             * ATET multivaluado (correcto):
.             *   ATET_k = E[ Y(k) - Y(0) | D = k ],  k=1,2,3
.             * Nota: con tratamiento multivaluado, `teffects ... , atet' reporta varios
.             *       contrastes dentro del mismo grupo tratado. Para obtener los 3 ATET
.             *       "naturales", corremos 3 veces fijando tlevel(k) y extraemos SOLO r#vs0.
.             *============================================================
.             tempname __b __V
110.             capture drop os_`mm' os_`mm'_t2 os_`mm'_t3
111.             forvalues t = 1/3 {
112.                 local __osname = cond(`t'==1, "os_`mm'", "os_`mm'_t`t'")
113.             
.             * pstolerance(${P0_FLOOR})
.                         teffects ipwra (Y_cond `X_y', logit) (`Dvar' `X_tr', mlogit), ///
>                     atet control(0) tlevel(`t') vce(cluster correlativo) osample(`__osname') 
114.             
.                 estimates store ATET_`mm'_`best_spec'_t`t'
115.                                 tebalance summarize
116.                                 
.                 matrix `__b' = e(b)
117.                 matrix `__V' = e(V)
118.                 local __cn : colfullnames `__b'
119.                 local __target ""
120.                 foreach __nm of local __cn {
121.                     if (strpos("`__nm'","ATET:r`t'vs0")>0) local __target "`__nm'"
122.                 }
123.                 if ("`__target'"=="") {
124.                     foreach __nm of local __cn {
125.                         if (strpos("`__nm'","ATET:`t'vs0")>0) local __target "`__nm'"
126.                     }
127.                 }
128.                 if ("`__target'"=="") {
129.                     di as error "No encontre el ATET relevante (t=`t' vs 0) en e(b). Colnames: `__cn'"
130.                     exit 459
131.                 }
132.                 scalar ATET`t' = el(`__b', 1, colnumb(`__b', "`__target'"))
133.                 scalar SE`t'   = sqrt(el(`__V', colnumb(`__V', "`__target'"), colnumb(`__V', "`__target'")))
134.                 local ATET_STR`t' : display %9.5f ATET`t'
135.                 local SE_STR`t'   : display %9.5f SE`t'
136.             }
137.             
.             * Mantener comportamiento "como antes" (tlevel default suele ser 1):
.             * - el estimation set ATET_`mm'_`best_spec' queda asociado a t=1
.             * - tebalance summarize se ejecuta sobre t=1 (para no cambiar el output existente)
.             *estimates restore ATET_`mm'_`best_spec'_t1
.             *estimates store ATET_`mm'_`best_spec'
.             *tebalance summarize
.             
.             di as text "ATET relevantes (multivaluado, control=0):"
138.             di as text "  ATET_1 = E[Y(1)-Y(0) | D=1] = `ATET_STR1'   (SE=`SE_STR1')"
139.             di as text "  ATET_2 = E[Y(2)-Y(0) | D=2] = `ATET_STR2'   (SE=`SE_STR2')"
140.             di as text "  ATET_3 = E[Y(3)-Y(0) | D=3] = `ATET_STR3'   (SE=`SE_STR3')"
141. 
. 
.             *---- Overlap: densidad de pscore por tlevel ----
.             quietly mlogit `Dvar' `X_tr', baseoutcome(0) nolog
142.             cap drop p0 p1 p2 p3
143.             predict double p0, outcome(0)
144.             predict double p1, outcome(1)
145.             predict double p2, outcome(2)
146.             predict double p3, outcome(3)
147. 
.             set scheme s2mono
148. 
.             local WTRIM = upper("${W_TRIM_STYLE}")
149.             local do_ps_trim = ${PS_TRIM}
150.             local ps_low  = ${PS0_LOW}
151.             local ps_high = ${PS0_HIGH}
152. 
.             forvalues t=1/3 {
153. 
.                 *--------------------------------------------
.                 * Muestra y pesos EXACTAMENTE como en el ranking
.                 *   (p0 floors + (opcional) PS trimming + wceil + (CAP/DROP) + normalización)
.                 *--------------------------------------------
.                 tempvar __use __w_raw __w __bad_ctrl __bad_tr __bad_ps __bad_wceil
154.                 gen byte `__use' = inlist(`Dvar',0,`t')
155. 
.                 gen byte `__bad_ctrl' = (`Dvar'==0   & (`__use'==1) & (p0<=${P0_FLOOR}       | missing(p0)))
156.                 gen byte `__bad_tr'   = (`Dvar'==`t' & (`__use'==1) & (p0<=${P0_TREAT_FLOOR} | missing(p0)))
157. 
.                 gen byte `__bad_ps' = 0
158.                 if (`do_ps_trim'==1) {
159.                     replace `__bad_ps' = (p0<`ps_low' | p0>`ps_high') if `__use'==1
160.                 }
161. 
.                 replace `__use' = 0 if `__bad_ctrl' | `__bad_tr' | `__bad_ps'
162. 
.                 gen double `__w_raw' = .
163.                 replace `__w_raw' = 1           if `Dvar'==`t' & `__use'==1
164.                 replace `__w_raw' = (p`t'/p0)   if `Dvar'==0   & `__use'==1
165. 
.                 gen byte `__bad_wceil' = (`Dvar'==0 & `__use'==1 & (missing(`__w_raw') | `__w_raw'<=0 | `__w_raw'>${W_CEIL}))
166.                 replace `__use' = 0 if `__bad_wceil'
167. 
.                 * Trimming por cuantil (solo controles, sobre la muestra "usada")
.                 local w_cap = .
168.                 quietly count if `Dvar'==0 & `__use'==1
169.                 local N0_for_trim = r(N)
170. 
.                 if (`N0_for_trim' > 0 & ${W_CAP_Q} < .) {
171.                     local pct = 100*${W_CAP_Q}
172.                     quietly centile `__w_raw' if `Dvar'==0 & `__use'==1, centile(`pct')
173.                     local w_cap = r(c_1)
174. 
.                     if (`w_cap' < . & `w_cap' > 0) {
175.                         if ("`WTRIM'"=="CAP") {
176.                             replace `__w_raw' = `w_cap' if `Dvar'==0 & `__use'==1 & `__w_raw' > `w_cap'
177.                         }
178.                         else if ("`WTRIM'"=="DROP") {
179.                             replace `__use' = 0 if `Dvar'==0 & `__use'==1 & `__w_raw' > `w_cap'
180.                         }
181.                     }
182.                 }
183. 
.                 * Normalizar controles a media 1 (Hájek): w = w_raw / mean(w_raw|D=0,usados)
.                 gen double `__w' = `__w_raw'
184.                 quietly summarize `__w' if `Dvar'==0 & `__use'==1, meanonly
185.                 local mw0 = r(mean)
186.                 if (`mw0'>0 & `mw0'<.) replace `__w' = `__w_raw'/`mw0' if `Dvar'==0 & `__use'==1
187.                 replace `__w' = . if `__use'==0
188. 
.                 *----------------------------
.                 * Overlap (densidad) y pesos (hist), usando la misma muestra "usada"
.                 *----------------------------
.                 twoway ///
>                     (kdensity p`t' if `Dvar'==0   & `__use'==1, lpattern(solid)) ///
>                     (kdensity p`t' if `Dvar'==`t' & `__use'==1, lpattern(dash)), ///
>                     legend(order(1 "Controles (0)" 2 "Tratados (`t')")) ///
>                     title("Overlap: Pr(D=`t') | Controles sin ponderar") ///
>                                         subtitle("ATET=`ATET_STR`t'' (SE=`SE_STR`t'') | Mode=`mm' Spec=`best_spec'") ///
>                     xtitle("Probabilidad predicha") ytitle("Densidad")
189. 
.                 graph export "${outdir}\overlap_`mm'_`best_spec'_t`t'.png", replace
190. 
.                 histogram `__w' if `Dvar'==0 & `__use'==1 & !missing(`__w'), percent ///
>                     title("Pesos t=`t' | Mode=`mm' Spec=`best_spec'") ///
>                                         subtitle("ATET=`ATET_STR`t'' | trim=`WTRIM' q=${W_CAP_Q}") ///
>                     xtitle("peso w (normalizado)") ytitle("%")
191. 
.                 graph export "${outdir}\weights_`mm'_`best_spec'_t`t'.png", replace
192. 
.                 drop `__use' `__w_raw' `__w' `__bad_ctrl' `__bad_tr' `__bad_ps' `__bad_wceil'
193.             }
194.         restore
195.     }
