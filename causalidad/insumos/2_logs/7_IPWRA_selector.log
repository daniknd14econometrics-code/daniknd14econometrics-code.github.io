. if $USE_LAGS == 1 {
. 
.     * Crear L1_ para TODAS las covariables "laggeables" (no incluye FE dummies)
.     local Xlist ${BASEVARS_CORE} ${ADD1} ${ADD2} ${ADD3} ${ADD4} ${Y_ADDVARS} ${Y_EXTRAVARS} ${EXTRA_TREAT} ${EXTRA_OUTCOME}
.     local Xlist : list uniq Xlist
. 
.     foreach v of local Xlist {
  2.         * Solo si existe y es numérica
.         capture confirm numeric variable `v'
  3.         if !_rc {
  4.             capture drop L1_`v'
  5.             gen double L1_`v' = L1.`v'
  6.         }
  7.     }
. }

. 
. 
. * (b) Helper: construir lista X usando L1_ cuando existe, si no usar contemporánea
. *========================
. * FIX ROBUSTO: build_xlist
. *========================
. cap program drop build_xlist

. program define build_xlist, rclass
  1.     version 19.0
  2.     syntax , BASE(string asis) [ADD(string asis)]
  3. 
.     * 1) Normalizar whitespace Unicode -> espacio (incluye NBSP, tabs, CR/LF, etc.)
.     local base_clean = ustrregexra("`base'", "[[:space:]]+", " ")
  4.     local add_clean  = ustrregexra("`add'",  "[[:space:]]+", " ")
  5. 
.     local base_clean = itrim(trim("`base_clean'"))
  6.     local add_clean  = itrim(trim("`add_clean'"))
  7. 
.     if ("`base_clean'"=="") {
  8.         di as error "build_xlist: BASE() vacío (no hay covariables base)."
  9.         return local xlist ""
 10.         return local skipped ""
 11.         exit 198
 12.     }
 13. 
.     * 2) Retokenizar como listas
.     local basevars : list retokenize base_clean
 14.     local addvars  : list retokenize add_clean
 15. 
.     * 3) Elegir L1_ si existe y tiene algún non-missing; si no, contemporánea.
.     local x ""
 16.     local skipped ""
 17. 
.     foreach v of local basevars {
 18.         local chosen ""
 19. 
.         * Solo numéricas
.         capture confirm numeric variable `v'
 20.         if (_rc) {
 21.             local skipped "`skipped' `v'(non_numeric_or_missing_var)"
 22.             continue
 23.         }
 24. 
.         if ($USE_LAGS==1) {
 25.             capture confirm numeric variable L1_`v'
 26.             if (!_rc) {
 27.                 quietly count if !missing(L1_`v')
 28.                 if (r(N)>0) local chosen "L1_`v'"
 29.             }
 30.         }
 31. 
.         if ("`chosen'"=="") {
 32.             quietly count if !missing(`v')
 33.             if (r(N)>0) local chosen "`v'"
 34.         }
 35. 
.         if ("`chosen'"!="") local x "`x' `chosen'"
 36.         else local skipped "`skipped' `v'(all_missing_in_sample)"
 37.     }
 38. 
.     foreach v of local addvars {
 39.         if ("`v'"=="") continue
 40.         local chosen ""
 41. 
.         capture confirm numeric variable `v'
 42.         if (_rc) {
 43.             local skipped "`skipped' `v'(non_numeric_or_missing_var)"
 44.             continue
 45.         }
 46. 
.         if ($USE_LAGS==1) {
 47.             capture confirm numeric variable L1_`v'
 48.             if (!_rc) {
 49.                 quietly count if !missing(L1_`v')
 50.                 if (r(N)>0) local chosen "L1_`v'"
 51.             }
 52.         }
 53. 
.         if ("`chosen'"=="") {
 54.             quietly count if !missing(`v')
 55.             if (r(N)>0) local chosen "`v'"
 56.         }
 57. 
.         if ("`chosen'"!="") local x "`x' `chosen'"
 58.         else local skipped "`skipped' `v'(all_missing_in_sample)"
 59.     }
 60. 
.     local x : list retokenize x
 61. 
.     if ("`x'"=="") {
 62.         di as error "build_xlist: NO quedó ninguna covariable usable (todas inexistentes/no numéricas/todo missing)."
 63.         di as error "BASE limpio: |`base_clean'|"
 64.         di as error "ADD  limpio: |`add_clean'|"
 65.         di as error "SKIPPED: `skipped'"
 66.         return local xlist ""
 67.         return local skipped "`skipped'"
 68.         exit 498
 69.     }
 70. 
.     return local xlist "`x'"
 71.     return local skipped "`skipped'"
 72. end

. 
