. capture program drop eval_balance

. program define eval_balance, rclass
  1.     * Calcula: max|SMD| y mean|SMD| sobre Xeval (Xcore si USE_CORE==1, Xbal si USE_CORE==0).
.     * Además: max|SMD| sobre el subconjunto core y, si aplica, sobre el subconjunto no-core.
.     * Nota: por pedido del usuario, NO calcula VR ni KS.
.     syntax, MATCHED(name) WATT(name)
  2. 
.     local ifc "`matched'==1"
  3. 
.     tempname maxa meana maxcore maxother
  4.     scalar `maxa'     = 0
  5.     scalar `meana'    = 0
  6.     scalar `maxcore'  = 0
  7.     scalar `maxother' = .
  8. 
.     local var_maxa    ""
  9.     local var_maxcore ""
 10.     local var_maxother ""
 11. 
.     local k = 0
 12. 
.     * --- Máximo y promedio absoluto en el set evaluado (Xeval) ---
.     foreach x of global Xeval {
 13.         quietly _smd_one `x', wvar(`watt') ifcond("`ifc'")
 14.         scalar smd = r(smd)
 15.         scalar abs_smd = abs(smd)
 16. 
.         scalar `meana' = `meana' + abs_smd
 17.         if (abs_smd > `maxa') {
 18.             scalar `maxa' = abs_smd
 19.             local var_maxa "`x'"
 20.         }
 21.         local ++k
 22.     }
 23.     if (`k'>0) scalar `meana' = `meana'/`k'
 24. 
.     * --- Core set (siempre, para poder aplicar umbrales diferenciales) ---
.     foreach x of global Xcore {
 25.         quietly _smd_one `x', wvar(`watt') ifcond("`ifc'")
 26.         scalar abs_smd = abs(r(smd))
 27.         if (abs_smd > `maxcore') {
 28.             scalar `maxcore' = abs_smd
 29.             local var_maxcore "`x'"
 30.         }
 31.     }
 32. 
.     * --- No-core (solo si existe Xother) ---
.     if ("$Xother"!="") {
 33.         scalar `maxother' = 0
 34.         foreach x of global Xother {
 35.             quietly _smd_one `x', wvar(`watt') ifcond("`ifc'")
 36.             scalar abs_smd = abs(r(smd))
 37.             if (abs_smd > `maxother') {
 38.                 scalar `maxother' = abs_smd
 39.                 local var_maxother "`x'"
 40.             }
 41.         }
 42.     }
 43. 
.     return scalar maxsmd   = `maxa'
 44.     return scalar meansmd  = `meana'
 45.     return scalar maxcore  = `maxcore'
 46.     return scalar maxother = `maxother'
 47. 
.     return local var_maxsmd   "`var_maxa'"
 48.     return local var_maxcore  "`var_maxcore'"
 49.     return local var_maxother "`var_maxother'"
 50. 
.     quietly _ess_controls, wvar(`watt') ifcond("`ifc'")
 51.     return scalar ess0 = r(ess0)
 52. end

. 
