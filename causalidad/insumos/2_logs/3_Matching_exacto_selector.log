. *========================
. * 5) Helpers: SMD, ESS, L1
. *========================
. capture program drop _smd_one

. program define _smd_one, rclass
  1.     * SMD con pesos ATT para controles; tratados peso=1.
.     syntax varname, WVAR(name) IFCOND(string)
  2. 
.     tempname m1 s1 m0 s0 sp
  3.     quietly summarize `varlist' if `ifcond' & $D==1
  4.     scalar `m1' = r(mean)
  5.     scalar `s1' = r(sd)
  6.     if (missing(`s1')) scalar `s1' = 0
  7. 
.     quietly summarize `varlist' [aw=`wvar'] if `ifcond' & $D==0
  8.     scalar `m0' = r(mean)
  9.     scalar `s0' = r(sd)
 10.     if (missing(`s0')) scalar `s0' = 0
 11. 
.     scalar `sp' = sqrt((`s1'^2 + `s0'^2)/2)
 12.     if (missing(`sp') | `sp'==0) return scalar smd = 0
 13.     else return scalar smd = (`m1' - `m0')/`sp'
 14. end

. 
. 
. capture program drop _ess_controls

. program define _ess_controls, rclass
  1.     * ESS de controles con pesos w: (sum w)^2 / sum(w^2)
.     syntax, WVAR(name) IFCOND(string)
  2. 
.     tempname sw sw2
  3.     quietly summarize `wvar' if `ifcond' & $D==0, meanonly
  4.     scalar `sw' = r(sum)
  5. 
.     tempvar w2
  6.     gen double `w2' = (`wvar')^2 if `ifcond' & $D==0
  7.     quietly summarize `w2' if `ifcond' & $D==0, meanonly
  8.     scalar `sw2' = r(sum)
  9.     drop `w2'
 10. 
.     if (`sw2'==0) return scalar ess0 = .
 11.     else return scalar ess0 = (`sw'^2)/`sw2'
 12. end

. 
