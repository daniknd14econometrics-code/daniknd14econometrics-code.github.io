. * --- Helper: construir estratos para Exact (S1/S2) respetando USE_CORE y ADD_SQ ---
. capture program drop make_stratum_exact

. program define make_stratum_exact
  1.     syntax, SCHEME(string) STRATUM(name)
  2. 
.     tempvar agebin edubin landbin pcirrbin
  3. 
.     if ("`scheme'"=="S1") {
  4.         recode agehead (min/25=1) (26/35=2) (36/45=3) (46/55=4) (56/65=5) (66/75=6) (76/max=7), gen(`agebin')
  5.         recode educhead (0=0) (1/4=1) (5/8=2) (9/max=3), gen(`edubin')
  6.         xtile `landbin'  = lnland, nq(4)
  7.         xtile `pcirrbin' = pcirr,  nq(4)
  8.     }
  9.     else if ("`scheme'"=="S2") {
 10.         recode agehead (min/35=1) (36/50=2) (51/65=3) (66/max=4), gen(`agebin')
 11.         recode educhead (0/2=0) (3/6=1) (7/max=2), gen(`edubin')
 12.         xtile `landbin'  = lnland, nq(3)
 13.         xtile `pcirrbin' = pcirr,  nq(3)
 14.     }
 15.     else {
 16.         di as error "scheme inválido. Usá S1 o S2."
 17.         exit 198
 18.     }
 19. 
.     * Base del grupo (core siempre presente)
.     local groupvars "sexhead vaccess `agebin' `edubin' `landbin' `pcirrbin'"
 20. 
.     * Extra vars solo si USE_CORE==0 (modo Xbal): discretización un poco más gruesa
.     if ($USE_CORE==0) {
 21.         foreach v of global Xextra_match {
 22.             tempvar b_`v'
 23.             if ("`scheme'"=="S1") xtile `b_`v'' = `v', nq($EXTRA_NQ_S1)
 24.             else                     xtile `b_`v'' = `v', nq($EXTRA_NQ_S2)
 25.             local groupvars "`groupvars' `b_`v''"
 26.         }
 27.     }
 28. 
.     * Cuadráticos (bins de cuadrados) si ADD_SQ==1
.     if ($ADD_SQ==1) {
 29.         * Asegurar que existan los cuadrados para Xcont
.         foreach v of global Xcont {
 30.             capture confirm variable `v'_sq
 31.             if (_rc) gen double `v'_sq = `v'^2
 32.         }
 33. 
.         tempvar age2bin edu2bin land2bin pcirr2bin
 34.         if ("`scheme'"=="S1") {
 35.             xtile `age2bin'   = agehead_sq,   nq(7)
 36.             xtile `edu2bin'   = educhead_sq,  nq(4)
 37.             xtile `land2bin'  = lnland_sq,    nq(4)
 38.             xtile `pcirr2bin' = pcirr_sq,     nq(4)
 39.         }
 40.         else {
 41.             xtile `age2bin'   = agehead_sq,   nq(4)
 42.             xtile `edu2bin'   = educhead_sq,  nq(3)
 43.             xtile `land2bin'  = lnland_sq,    nq(3)
 44.             xtile `pcirr2bin' = pcirr_sq,     nq(3)
 45.         }
 46.         local groupvars "`groupvars' `age2bin' `edu2bin' `land2bin' `pcirr2bin'"
 47. 
.         if ($USE_CORE==0) {
 48.             foreach v of global Xextra_match {
 49.                 tempvar b2_`v'
 50.                 if ("`scheme'"=="S1") xtile `b2_`v'' = `v'_sq, nq($EXTRA_NQ_S1)
 51.                 else                     xtile `b2_`v'' = `v'_sq, nq($EXTRA_NQ_S2)
 52.                 local groupvars "`groupvars' `b2_`v''"
 53.             }
 54.         }
 55.     }
 56. 
.     egen `stratum' = group(`groupvars'), label
 57. end

. 
