. capture program drop exact_atet

. program define exact_atet, rclass
  1.     * ATET por Exact Matching (estratos), respetando USE_CORE y ADD_SQ.
.     syntax, SCHEME(string)
  2. 
.     tempvar stratum N1 N0 support y1_tmp y0_tmp
  3. 
.     quietly make_stratum_exact, scheme(`scheme') stratum(`stratum')
  4. 
.     bys `stratum': egen `N1' = total($D==1)
  5.     bys `stratum': egen `N0' = total($D==0)
  6.     gen byte `support' = (`N1'>0 & `N0'>0)
  7. 
.     preserve
  8.         keep if `support'==1
  9. 
.         gen double `y1_tmp' = $Y if $D==1
 10.         gen double `y0_tmp' = $Y if $D==0
 11. 
.         collapse ///
>             (sum)  N1cell = $D ///
>             (mean) y1 = `y1_tmp' ///
>             (mean) y0 = `y0_tmp' ///
>             , by(`stratum')
 12. 
.         gen diff = y1 - y0
 13. 
.         quietly summarize N1cell, meanonly
 14.         scalar N1tot = r(sum)
 15. 
.         gen double w_atet = N1cell/N1tot
 16.         gen double c_atet = w_atet*diff
 17.         quietly summarize c_atet, meanonly
 18.         return scalar atet = r(sum)
 19.     restore
 20. end

. 
. 
. capture program drop exact_atet_boot

. program define exact_atet_boot, rclass
  1.     syntax, SCHEME(string)
  2.     quietly exact_atet, scheme(`scheme')
  3.     return scalar atet = r(atet)
  4. end

. 
