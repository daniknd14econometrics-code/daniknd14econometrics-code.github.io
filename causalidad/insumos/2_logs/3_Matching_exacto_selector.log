. *-------- 7.1 Exact candidates --------
. foreach sc in S1 S2 {
  2. 
.     * Recargar base limpia en cada candidato (evita preserve anidado y arrastres).
.     use `base', clear
  3. 
.     * Construir estratos y pesos ATT (controles ponderados por N1cell/N0cell dentro de estrato)
.     tempvar stratum N1cell N0cell matched w_att
  4. 
.     quietly make_stratum_exact, scheme(`sc') stratum(`stratum')
  5. 
.     bys `stratum': egen `N1cell' = total($D==1)
  6.     bys `stratum': egen `N0cell' = total($D==0)
  7.     gen byte `matched' = (`N1cell'>0 & `N0cell'>0)
  8. 
.     * Pesos ATT: tratados peso=1, controles peso=N1cell/N0cell dentro de estrato
.     gen double `w_att' = 1
  9.     replace `w_att' = `N1cell'/`N0cell' if $D==0 & `matched'==1
 10. 
.     quietly count if `matched'==1 & $D==1
 11.     scalar N1 = r(N)
 12.     quietly count if `matched'==1 & $D==0
 13.     scalar N0 = r(N)
 14. 
.     * Si no hay soporte común, posteamos missings y seguimos
.     if (N1==0 | N0==0) {
 15.         scalar maxsmd  = .
 16.         scalar meansmd = .
 17.         scalar maxcore = .
 18.         scalar maxother = .
 19.         scalar ess0    = .
 20.         scalar L1      = .
 21.         local vmaxsmd   ""
 22.         local vmaxcore  ""
 23.         local vmaxother ""
 24.         post `ph' ("Exact") ("`sc'") (maxsmd) (meansmd) (maxcore) (maxother) ("`vmaxsmd'") ("`vmaxcore'") ("`vmaxother'") (L1) (.) (ess0) (N1) (N0)
 25.         continue
 26.     }
 27. 
.     quietly eval_balance, matched(`matched') watt(`w_att')
 28.     scalar maxsmd  = r(maxsmd)
 29.     scalar meansmd = r(meansmd)
 30.     scalar maxcore = r(maxcore)
 31.     scalar ess0    = r(ess0)
 32.     scalar maxother = r(maxother)
 33.     local vmaxsmd   "`r(var_maxsmd)'"
 34.     local vmaxcore  "`r(var_maxcore)'"
 35.     local vmaxother "`r(var_maxother)'"
 36. 
.     * L1 (manual) entre distribuciones de estratos en tratados vs controles (en soporte)
.     keep if `matched'==1
 37.     tempvar n1 n0 p1 p0 abs
 38.     bys `stratum': egen `n1' = total($D==1)
 39.     bys `stratum': egen `n0' = total($D==0)
 40.     bys `stratum': keep if _n==1
 41. 
.     quietly summarize `n1', meanonly
 42.     scalar N1t = r(sum)
 43.     quietly summarize `n0', meanonly
 44.     scalar N0t = r(sum)
 45. 
.     if (N1t==0 | N0t==0 | missing(N1t) | missing(N0t)) {
 46.         scalar L1 = .
 47.     }
 48.     else {
 49.         gen double `p1'  = `n1'/N1t
 50.         gen double `p0'  = `n0'/N0t
 51.         gen double `abs' = abs(`p1' - `p0')
 52.         quietly summarize `abs', meanonly
 53.         scalar L1 = 0.5*r(sum)
 54.     }
 55. 
.     post `ph' ("Exact") ("`sc'") (maxsmd) (meansmd) (maxcore) (maxother) ("`vmaxsmd'") ("`vmaxcore'") ("`vmaxother'") (L1) (.) (ess0) (N1) (N0)
 56. }
