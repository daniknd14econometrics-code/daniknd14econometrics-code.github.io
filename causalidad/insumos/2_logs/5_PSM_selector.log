. *--- 3.1 Util: ESS para controles con pesos (w) ---
. capture program drop _ess_controls

. program define _ess_controls, rclass
  1.     syntax varname [if]
  2.     quietly {
  3.         tempname sw sw2
  4.         tempvar w w2
  5. 
.         gen double `w' = `varlist' `if'
  6.         replace `w' = 0 if missing(`w')
  7.         summ `w' `if', meanonly
  8.         scalar `sw' = r(sum)
  9. 
.         gen double `w2' = `w'^2 `if'
 10.         summ `w2' `if', meanonly
 11.         scalar `sw2' = r(sum)
 12. 
.         if (`sw2'==0) {
 13.             return scalar ess0 = 0
 14.         }
 15.         else {
 16.             return scalar ess0 = (`sw'^2)/`sw2'
 17.         }
 18.     }
 19. end

. 
. *--- 3.2 Balance: max|SMD|, mean|SMD|, max var-ratio sym, mean |ln(VR)| + Rubin B/R del PS ---
. capture program drop _eval_balance_psm

. program define _eval_balance_psm, rclass
  1.     * Requiere:
.     *   - variable de tratamiento: $D (0/1)
.     *   - variable w_att (peso usado para controles; para tratados = 1)
.     *   - variable matched (1 si entra a comparación)
.     *   - variable lps (logit(PS) con clamp)
.     *
.     syntax, WATT(varname) MATCHED(varname) LPS(varname)
  2. 
.     quietly {
  3.         local xlist "$Xbal"
  4.         tempname maxsmd meansmd maxvr meanlnvr Bps Rps
  5.         scalar `maxsmd'  = 0
  6.         scalar `meansmd' = 0
  7.         scalar `maxvr'   = 1
  8.         scalar `meanlnvr'= 0
  9. 
.         local vmaxsmd ""
 10.         local vmaxvr  ""
 11. 
.         local count = 0
 12. 
.         foreach x of varlist `xlist' {
 13.             * Tratados
.             capture noisily summ `x' if `matched'==1 & $D==1
 14.             if _rc continue
 15.             local m1 = r(mean)
 16.             local s1 = r(sd)
 17. 
.             * Controles (ponderados por matching)
.             capture noisily summ `x' if `matched'==1 & $D==0 [aw=`watt']
 18.             if _rc continue
 19.             local m0 = r(mean)
 20.             local s0 = r(sd)
 21. 
.             * pooled SD
.             local sp = sqrt((`s1'^2 + `s0'^2)/2)
 22.             if (`sp'<=0 | missing(`sp')) continue
 23. 
.             local smd = (`m1' - `m0')/`sp'
 24.             local asmd = abs(`smd')
 25. 
.             scalar `meansmd' = `meansmd' + `asmd'
 26.             local ++count
 27. 
.             if (`asmd' > `maxsmd') {
 28.                 scalar `maxsmd' = `asmd'
 29.                 local vmaxsmd "`x'"
 30.             }
 31. 
.             * variance ratio (simetrizado)
.             local vr = 1
 32.             if (`s0'>0 & `s1'>=0) {
 33.                 local vr = (`s1'^2)/(`s0'^2)
 34.                 if (`vr'<=0 | missing(`vr')) local vr = 1
 35.             }
 36.             local vrsym = max(`vr', 1/`vr')
 37.             scalar `meanlnvr' = `meanlnvr' + abs(ln(`vr'))
 38. 
.             if (`vrsym' > `maxvr') {
 39.                 scalar `maxvr' = `vrsym'
 40.                 local vmaxvr "`x'"
 41.             }
 42.         }
 43. 
.         if (`count'>0) {
 44.             scalar `meansmd'  = `meansmd'/`count'
 45.             scalar `meanlnvr' = `meanlnvr'/`count'
 46.         }
 47.         else {
 48.             scalar `meansmd'  = .
 49.             scalar `meanlnvr' = .
 50.         }
 51. 
.         * Rubin's B y R (sobre el índice/linear predictor: lps = logit(PS))
.         * B_ps en porcentaje de SD (como se reporta usualmente)
.         capture noisily summ `lps' if `matched'==1 & $D==1
 52.         local m1p = r(mean)
 53.         local s1p = r(sd)
 54.         capture noisily summ `lps' if `matched'==1 & $D==0 [aw=`watt']
 55.         local m0p = r(mean)
 56.         local s0p = r(sd)
 57.         local spp = sqrt((`s1p'^2 + `s0p'^2)/2)
 58.         if (`spp'>0 & !missing(`spp')) {
 59.             scalar `Bps' = 100*abs(`m1p' - `m0p')/`spp'
 60.         }
 61.         else scalar `Bps' = .
 62. 
.         if (`s0p'>0 & `s1p'>=0) {
 63.             local rp = (`s1p'^2)/(`s0p'^2)
 64.             scalar `Rps' = max(`rp', 1/`rp')
 65.         }
 66.         else scalar `Rps' = .
 67. 
.         return scalar maxsmd   = `maxsmd'
 68.         return scalar meansmd  = `meansmd'
 69.         return scalar maxvr    = `maxvr'
 70.         return scalar meanlnvr = `meanlnvr'
 71.         return scalar B_ps     = `Bps'
 72.         return scalar R_ps     = `Rps'
 73.         return local var_maxsmd "`vmaxsmd'"
 74.         return local var_maxvr  "`vmaxvr'"
 75.     }
 76. end

. 
. *--- 3.3 Ejecuta un candidato (DISEÑO): psmatch2 sin outcome, y devuelve métricas ---
. capture program drop _eval_candidate

. program define _eval_candidate, rclass
  1.     syntax, METHOD(string) SUPPORT(string) OPTS(string) ///
>            [K(integer 0) CAL(real 0) BW(real 0) KERNEL(string)]
  2. 
.     quietly {
  3.         * limpiar residuos de psmatch2 de corridas previas
.         capture drop _pscore _weight _id _n1 _n2 _n3 _n4 _n5 _nn _support
  4. 
.         * psmatch2 SIN outcome: solo para generar _weight y _support
.         capture confirm variable ps_hat
  5.         if _rc {
  6.             return scalar ok = 0
  7.             exit
  8.         }
  9. 
.         capture noisily psmatch2 $D, pscore(ps_hat) `opts'
 10.         if _rc {
 11.             return scalar ok = 0
 12.             exit
 13.         }
 14. 
.         * si _support no existe, asumimos todo soporte
.         capture confirm variable _support
 15.         if _rc gen byte _support = 1
 16. 
.         * weights para balance: tratados peso 1; controles peso _weight
.         tempvar w_att matched
 17.         gen double `w_att' = 0
 18.         replace `w_att' = 1       if $D==1 & _support==1
 19.         replace `w_att' = _weight if $D==0 & _support==1
 20.         replace `w_att' = 0 if missing(`w_att')
 21. 
.         gen byte `matched' = 0
 22.         replace `matched' = 1 if $D==1 & _support==1
 23.         replace `matched' = 1 if $D==0 & _support==1 & `w_att'>0
 24. 
.         * conteos
.         count if `matched'==1 & $D==1
 25.         local N1 = r(N)
 26.         count if `matched'==1 & $D==0 & `w_att'>0
 27.         local N0 = r(N)
 28. 
.         * ESS de controles
.         _ess_controls `w_att' if `matched'==1 & $D==0
 29.         local ess0 = r(ess0)
 30. 
.         * balance
.         _eval_balance_psm, watt(`w_att') matched(`matched') lps(lps)
 31.         local maxsmd   = r(maxsmd)
 32.         local meansmd  = r(meansmd)
 33.         local maxvr    = r(maxvr)
 34.         local meanlnvr = r(meanlnvr)
 35.         local B_ps     = r(B_ps)
 36.         local R_ps     = r(R_ps)
 37.         local vmsmd    = r(var_maxsmd)
 38.         local vmvr     = r(var_maxvr)
 39. 
.         return scalar ok       = 1
 40.         return scalar N1       = `N1'
 41.         return scalar N0       = `N0'
 42.         return scalar ess0     = `ess0'
 43.         return scalar maxsmd   = `maxsmd'
 44.         return scalar meansmd  = `meansmd'
 45.         return scalar maxvr    = `maxvr'
 46.         return scalar meanlnvr = `meanlnvr'
 47.         return scalar B_ps     = `B_ps'
 48.         return scalar R_ps     = `R_ps'
 49.         return local  var_maxsmd "`vmsmd'"
 50.         return local  var_maxvr  "`vmvr'"
 51.     }
 52. end

. 
