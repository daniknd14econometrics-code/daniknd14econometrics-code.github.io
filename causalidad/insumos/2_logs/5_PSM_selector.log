. *------------------------
. * 5.1 Construir distancia y flags globales
. *------------------------
. local distopt ""

. if ($USE_ODDS==1) local distopt "odds"

. 
. local tiesopt ""

. if ($USE_TIES==1) local tiesopt "ties"

. 
. *------------------------
. * 5.2 Loop por soporte
. *------------------------
. foreach supp in $SUPPORT_LIST {
  2. 
.     * 5.2.1 Nearest Neighbor: k=1..5 (sin caliper)
.     foreach kk in $K_LIST {
  3.         preserve
  4.             use `base', clear
  5.             keep if `touse'==1
  6. 
.             * psmatch2 usa la variable _pscore si estima PS internamente.
.             * Acá forzamos usar nuestro PS (ps_hat) ya estimado, para mantener escala estable.
.             local opts "`supp' `distopt' `tiesopt' neighbor(`kk')"
  7. 
.             quietly _eval_candidate, method("NN") support("`supp'") opts("`opts'") k(`kk')
  8. 
.             if (r(ok)==1) {
  9.                 local share1 = r(N1)/TOT1
 10.                 post `posth' ///
>                     ("NN") ("`supp'") ///
>                     ("k=`kk' + `supp'") ///
>                     ("`opts'") ///
>                     (`kk') (.) (.) ("") ///
>                     (r(maxsmd)) (r(meansmd)) (r(maxvr)) (r(meanlnvr)) ///
>                     (r(B_ps)) (r(R_ps)) ///
>                     ("`r(var_maxsmd)'") ("`r(var_maxvr)'") ///
>                     (r(N1)) (r(N0)) (r(ess0)) (`share1')
 11.             }
 12.         restore
 13.     }
 14. 
.     * 5.2.2 NN + Caliper (k=1): calipers como múltiplos de SD_LPS
.     foreach cm in $CAL_MULT {
 15.         local cal = `cm'*SD_LPS
 16.         preserve
 17.             use `base', clear
 18.             keep if `touse'==1
 19.             local opts "`supp' `distopt' `tiesopt' neighbor(1) caliper(`cal')"
 20.             quietly _eval_candidate, method("CAL") support("`supp'") opts("`opts'") k(1) cal(`cal')
 21. 
.             if (r(ok)==1) {
 22.                 local share1 = r(N1)/TOT1
 23.                 post `posth' ///
>                     ("CAL") ("`supp'") ///
>                     ("k=1 cal=`cm'*SD(LPS) + `supp'") ///
>                     ("`opts'") ///
>                     (1) (`cal') (.) ("") ///
>                     (r(maxsmd)) (r(meansmd)) (r(maxvr)) (r(meanlnvr)) ///
>                     (r(B_ps)) (r(R_ps)) ///
>                     ("`r(var_maxsmd)'") ("`r(var_maxvr)'") ///
>                     (r(N1)) (r(N0)) (r(ess0)) (`share1')
 24.             }
 25.         restore
 26.     }
 27. 
.     * 5.2.3 Radius: calipers como múltiplos de SD_LPS
.     foreach cm in $CAL_MULT {
 28.         local cal = `cm'*SD_LPS
 29.         preserve
 30.             use `base', clear
 31.             keep if `touse'==1
 32.             local opts "`supp' `distopt' `tiesopt' radius caliper(`cal')"
 33.             quietly _eval_candidate, method("RAD") support("`supp'") opts("`opts'") cal(`cal')
 34. 
.             if (r(ok)==1) {
 35.                 local share1 = r(N1)/TOT1
 36.                 post `posth' ///
>                     ("RAD") ("`supp'") ///
>                     ("radius cal=`cm'*SD(LPS) + `supp'") ///
>                     ("`opts'") ///
>                     (.) (`cal') (.) ("") ///
>                     (r(maxsmd)) (r(meansmd)) (r(maxvr)) (r(meanlnvr)) ///
>                     (r(B_ps)) (r(R_ps)) ///
>                     ("`r(var_maxsmd)'") ("`r(var_maxvr)'") ///
>                     (r(N1)) (r(N0)) (r(ess0)) (`share1')
 37.             }
 38.         restore
 39.     }
 40. 
.     * 5.2.4 Kernel: tipos x bandas
.     foreach kt in $KERNEL_LIST {
 41.         foreach hm in $H_MULT {
 42.             local bw = `hm'*SD_LPS
 43.             preserve
 44.                 use `base', clear
 45.                 keep if `touse'==1
 46.                 local opts "`supp' `distopt' `tiesopt' kernel kerneltype(`kt') bwidth(`bw')"
 47.                 quietly _eval_candidate, method("KER") support("`supp'") opts("`opts'") bw(`bw') kernel("`kt'")
 48. 
.                 if (r(ok)==1) {
 49.                     local share1 = r(N1)/TOT1
 50.                     post `posth' ///
>                         ("KER") ("`supp'") ///
>                         ("kernel=`kt' bw=`hm'*SD(LPS) + `supp'") ///
>                         ("`opts'") ///
>                         (.) (.) (`bw') ("`kt'") ///
>                         (r(maxsmd)) (r(meansmd)) (r(maxvr)) (r(meanlnvr)) ///
>                         (r(B_ps)) (r(R_ps)) ///
>                         ("`r(var_maxsmd)'") ("`r(var_maxvr)'") ///
>                         (r(N1)) (r(N0)) (r(ess0)) (`share1')
 51.                 }
 52.             restore
 53.         }
 54.     }
 55. }
