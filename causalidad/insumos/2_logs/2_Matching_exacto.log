. capture program drop cem_est

. program define cem_est, rclass
  1.     tempvar y1t y0t w w1 w0 wy1 wy0
  2. 
.     capture drop cem_matched cem_weights cem_strata
  3.     cem sexhead vaccess agehead educhead lnland pcirr, tr($D) autocuts(fd)
  4. 
.     preserve
  5.         keep if cem_matched==1
  6. 
.         gen double `w' = cem_weights
  7.         gen double `y1t' = $Y if $D==1
  8.         gen double `y0t' = $Y if $D==0
  9. 
.         gen double `w1'  = `w' if $D==1
 10.         gen double `w0'  = `w' if $D==0
 11.         gen double `wy1' = `w'*`y1t'
 12.         gen double `wy0' = `w'*`y0t'
 13. 
.         collapse ///
>             (sum) W1  = `w1' ///
>             (sum) W0  = `w0' ///
>             (sum) WY1 = `wy1' ///
>             (sum) WY0 = `wy0' ///
>             , by(cem_strata)
 14. 
.         gen y1 = WY1/W1
 15.         gen y0 = WY0/W0
 16.         gen diff = y1 - y0
 17. 
.         quietly summarize W1, meanonly
 18.         local W1tot = r(sum)
 19. 
.         gen w_atet = W1/`W1tot'
 20.         gen c_atet = w_atet * diff
 21. 
.         quietly summarize c_atet, meanonly
 22.         return scalar atet = r(sum)
 23.     restore
 24. end

