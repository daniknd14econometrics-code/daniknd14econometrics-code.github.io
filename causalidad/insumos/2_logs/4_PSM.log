. *---------------------------
. * B4.3 Kernel matching: mostraremos 3 kernel (K(.)) y 2 bandwidths (h) diferentes como ejemplos
. *---------------------------
. * Kernels: epan (default), normal, uniform
. * Bandwidths: 0.03 y 0.06 (0.06 es un default común en psmatch2)
. foreach K in epan normal uniform {
  2.     foreach H in 0.03 0.06 {
  3.         psmatch2 $D $X, out($Y) common kernel k(`K') bwidth(`H') ate
  4.                 scalar ATE_psm  = r(ate)
  5.                 scalar ATET_psm = r(att)
  6.                 scalar SE_ATE_psm  = .
  7.                 scalar SE_ATET_psm = .
  8.                 quietly count if _support==1 & $D==1
  9.                 scalar N1_psm = r(N)
 10.                 quietly count if _support==1 & $D==0
 11.                 scalar N0_psm = r(N)
 12.                  post `_posth' ("PSM (psmatch2)") ("common") ("Kernel(`K') h=`H'") ///
>          (ATE_psm) (ATET_psm) (SE_ATE_psm) (SE_ATET_psm) (N1_psm) (N0_psm)
 13.          display as result "Kernel(`K'), h=`H'+common: ATET=" %9.6f  ATET_psm " | ATE=" %9.6f  ATE_psm
 14. 
.     }
 15. }

