. matrix b = e(b)

. matrix V = e(V)

. scalar ATE_te = b[1,1]

. scalar SE_ATE_te = sqrt(V[1,1])

. quietly count if e(sample) & $D==1

. scalar N1_te = r(N)

. quietly count if e(sample) & $D==0

. scalar N0_te = r(N)

. post `_posth' ("teffects") ("psmatch") ("ATE, nn(1)") (ATE_te) (.) (SE_ATE_te) (.) (N1_te) (N0_te)

. 
. * ATET
. teffects psmatch ($Y) ($D $X, probit), atet vce(robust)

