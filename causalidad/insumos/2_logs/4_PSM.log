. quietly count if e(sample) & $D==1

. scalar N1_te = r(N)

. quietly count if e(sample) & $D==0

. scalar N0_te = r(N)

. post `_posth' ("teffects") ("psmatch") ("ATET, nn(1)") (.) (ATET_te) (.) (SE_ATET_te) (N1_te) (N0_te)

