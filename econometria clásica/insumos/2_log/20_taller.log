. 
. * Bootstrap recomendado para inferencia (incorpora ambas etapas):
. 
. 
. *======================================================================
. * Control function (endogeneidad aproximada) en dos etapas + bootstrap
. *======================================================================
. 
. *      Bootstrap correcto (coeficientes de segunda etapa)
. *      La corrección concreta que necesitás es: calcular los APE usando las probabilidades predichas del ordened probit
. *               si tuviera un panel, agregaria dummies temporales y pondria vce(cluster id)
.  
. 
. cap program drop cf16_just

. program define cf16_just, rclass
  1.     version 16.0
  2.     tempvar vhat
  3.     tempname B
  4.     local xvars         educ age wealth89
  5.     local xvars_factor  choice female married black finc25 finc35 finc50 finc75 finc100 finc101 prftshr
  6.     * 1ra etapa
.     quietly regress educ age wealth89 i.choice i.female i.married i.black i.finc25 i.finc35 i.finc50 i.finc75 i.finc100 i.finc101 i.prftshr pyears, vce(robust)
  7.     quietly predict double `vhat', resid
  8.     return scalar pi_pyears = _b[pyears]
  9. 
.     * 2da etapa (OrdProbit + CF)
.     quietly oprobit pctstck  educ age wealth89 i.choice i.female i.married i.black i.finc25 i.finc35 i.finc50 i.finc75 i.finc100 i.finc101 i.prftshr  `vhat', vce(r
> obust)
 10. 
.     * AMEs por outcome: predict(outcome(#))
.     foreach j in 0 50 100 {
 11. 
.         quietly margins, dydx(`xvars' `xvars_factor') predict(outcome(`j'))
 12.         matrix `B' = r(b)
 13. 
.         * continuas
.         foreach k of local xvars {
 14.             local c = colnumb(`B', "`k'")
 15.             if (`c'==.) {
 16.                 di as err "No encuentro `k' en margins outcome(`j'). Revisá colnames: "
 17.                 matrix list `B'
 18.                 exit 198
 19.             }
 20.             return scalar ape_`k'_out`j' = `B'[1,`c']
 21.         }
 22. 
.                 * discretas
.         foreach m of local xvars_factor {
 23.             local c = colnumb(`B', "`m'")
 24.                         if (`c'==.) local c = colnumb(`B', "1.`m'")
 25.             if (`c'==.) {
 26.                 di as err "No encuentro `m' en margins outcome(`j'). Revisá colnames: "
 27.                 matrix list `B'
 28.                 exit 198
 29.             }
 30.             return scalar ape_`m'_out`j' = `B'[1,`c']
 31.         }
 32.         }               
 33. end

. 
. 
. cf16_just

