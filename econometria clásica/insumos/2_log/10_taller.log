                                  union   ->   union1 union2 ... union8
                                married   ->   married1 married2 ... married8
-----------------------------------------------------------------------------

. scalar Tmax = `T'

. 
. /*** 3) Crear listas wide para Mata ***/
. local ywide ""

. forvalues tt=1/`T' {
  2.     local ywide "`ywide' `y'`tt'"
  3. }

. foreach x of local Xtv {
  2.     local `x'wide ""
  3.     forvalues tt=1/`T' {
  4.         local `x'wide "``x'wide' `x'`tt'"
  5.     }
  6. }

