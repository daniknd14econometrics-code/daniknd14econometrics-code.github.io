. capture program drop _gmm_make_singleeq

. program define _gmm_make_singleeq, eclass
  1.     tempname b V b2 V2
  2.     matrix `b' = e(b)
  3.     matrix `V' = e(V)
  4. 
.     local peqs "b_exper b_expersq b_union b_married"
  5.     local pnam "exper expersq union married"
  6. 
.     matrix `b2' = J(1,4,.)
  7.     matrix `V2' = J(4,4,.)
  8. 
.     forvalues i=1/4 {
  9.         local eqi : word `i' of `peqs'
 10.         matrix `b2'[1,`i'] = `b'[1,"`eqi':_cons"]
 11. 
.         forvalues j=1/4 {
 12.             local eqj : word `j' of `peqs'
 13.             matrix `V2'[`i',`j'] = `V'["`eqi':_cons","`eqj':_cons"]
 14.         }
 15.     }
 16. 
.     matrix colnames `b2' = `pnam'
 17.     matrix rownames `V2' = `pnam'
 18.     matrix colnames `V2' = `pnam'
 19. 
.     * Postear como si fuera un modelo "normal"
.     ereturn post `b2' `V2', obs(`e(N)')
 20.     ereturn local cmd "gmm_FE_helm_RE_clean"
 21. end

