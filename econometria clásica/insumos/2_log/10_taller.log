       exper |   .1120669   .0082603    13.57   0.000     .0958771    .1282567
     expersq |  -.0040646   .0005918    -6.87   0.000    -.0052244   -.0029047
       union |   .1076277   .0178226     6.04   0.000     .0726961    .1425593
     married |   .0627744   .0167705     3.74   0.000     .0299048    .0956439
