. /*** 5) Armar momentos FE compactos: Σ_h xH_h * (yH_h - β'xH_h) = 0 ***/
. local Klist `Xtv'

. local Hmax = `T' - 1

. 
. local M_exper   ""

. local M_expersq ""

. local M_union   ""

. local M_married ""

. 
. forvalues h=1/`Hmax' {
  2.     local rH "(yH`h' - {b_exper}*experH`h' - {b_expersq}*expersqH`h' - {b_union}*unionH`h' - {b_married}*marriedH`h')"
  3. 
.     local te "experH`h'*(`rH')"
  4.     local ts "expersqH`h'*(`rH')"
  5.     local tu "unionH`h'*(`rH')"
  6.     local tm "marriedH`h'*(`rH')"
  7. 
.     if "`M_exper'"==""   local M_exper   "`te'"
  8.     else                 local M_exper   "`M_exper' + `te'"
  9. 
.     if "`M_expersq'"=="" local M_expersq "`ts'"
 10.     else                 local M_expersq "`M_expersq' + `ts'"
 11. 
.     if "`M_union'"==""   local M_union   "`tu'"
 12.     else                 local M_union   "`M_union' + `tu'"
 13. 
.     if "`M_married'"=="" local M_married "`tm'"
 14.     else                 local M_married "`M_married' + `tm'"
 15. }

. 
