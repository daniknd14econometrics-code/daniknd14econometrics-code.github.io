. /********************************************************************/
. /*  5) AHORA PASAMOS A WIDE SOLO PARA ESCRIBIR LOS MOMENTOS g_i      */
. /*     (gmm trabaja a nivel "observación"; acá 1 obs = 1 individuo)   */
. /********************************************************************/
. egen t = group(`time')

. quietly levelsof t, local(tlist)

. local T : word count `tlist'

. di ">> Tmax en la muestra (para reshape) = `T'"
>> Tmax en la muestra (para reshape) = 8

. 
. /* Nos quedamos con lo necesario antes de reshape */
. keep `id' t `y' `X' ///
>      one ///
>      *_bar ///
>      exper_dm expersq_dm union_dm married_dm

. 
. reshape wide `y' `X' exper_dm expersq_dm union_dm married_dm, i(`id') j(t)
(j = 1 2 3 4 5 6 7 8)

Data                               Long   ->   Wide
-----------------------------------------------------------------------------
Number of observations            4,360   ->   545         
Number of variables                  20   ->   96          
j variable (8 values)                 t   ->   (dropped)
xij variables:
                                  lwage   ->   lwage1 lwage2 ... lwage8
                                   educ   ->   educ1 educ2 ... educ8
                                  exper   ->   exper1 exper2 ... exper8
                                expersq   ->   expersq1 expersq2 ... expersq8
                                  union   ->   union1 union2 ... union8
                                married   ->   married1 married2 ... married8
                                  black   ->   black1 black2 ... black8
                               exper_dm   ->   exper_dm1 exper_dm2 ... exper_dm8
                             expersq_dm   ->   expersq_dm1 expersq_dm2 ... expersq_dm8
                               union_dm   ->   union_dm1 union_dm2 ... union_dm8
                             married_dm   ->   married_dm1 married_dm2 ... married_dm8
-----------------------------------------------------------------------------

. 
. /********************************************************************/
. /*  6) ARMAR MOMENTOS (K+M) EXACTOS DE (11.4)                         */
. /*     - Momento "constante": sum_t v_it = 0                          */
. /*     - Para cada x_bar: x_bar * sum_t v_it = 0                      */
. /*     - Para cada w: sum_t (w_dm_it * v_it) = 0                      */
. /********************************************************************/
. local Rsum ""

. forvalues tt=1/`T' {
  2.     // indicador obs en t para evitar propagación de missing
.     local obs = "(!missing(`y'`tt'))"
  3. 
.     // residuo en t
.     local rt = "(`y'`tt' - {b0} - {b_educ}*educ`tt' - {b_exper}*exper`tt' - {b_expersq}*expersq`tt' - {b_union}*union`tt' - {b_married}*married`tt' - {b_black}*bla
> ck`tt')"
  4. 
.     // sumar solo si obs
.     if "`Rsum'"=="" local Rsum "cond(`obs', `rt', 0)"
  5.     else            local Rsum "`Rsum' + cond(`obs', `rt', 0)"
  6. }

. 
. /* Momentos within: sum_t w_dm_t * v_t */
. local M_exper    ""

. local M_expersq  ""

. local M_union    ""

. local M_married  ""

. 
. forvalues tt=1/`T' {
  2.     local obs = "(!missing(`y'`tt'))"
  3.     local rt  = "(`y'`tt' - {b0} - {b_educ}*educ`tt' - {b_exper}*exper`tt' - {b_expersq}*expersq`tt' - {b_union}*union`tt' - {b_married}*married`tt' - {b_black}
> *black`tt')"
  4. 
.     // cada término: cond(obs & !missing(w_dm_t), w_dm_t*rt, 0)
.     local te = "cond(`obs' & !missing(exper_dm`tt'),   exper_dm`tt'*(`rt'),   0)"
  5.     local ts = "cond(`obs' & !missing(expersq_dm`tt'), expersq_dm`tt'*(`rt'), 0)"
  6.     local tu = "cond(`obs' & !missing(union_dm`tt'),   union_dm`tt'*(`rt'),   0)"
  7.     local tm = "cond(`obs' & !missing(married_dm`tt'), married_dm`tt'*(`rt'), 0)"
  8. 
.     if "`M_exper'"==""   local M_exper   "`te'"
  9.     else                 local M_exper   "`M_exper' + `te'"
 10. 
.     if "`M_expersq'"=="" local M_expersq "`ts'"
 11.     else                 local M_expersq "`M_expersq' + `ts'"
 12. 
.     if "`M_union'"==""   local M_union   "`tu'"
 13.     else                 local M_union   "`M_union' + `tu'"
 14. 
.     if "`M_married'"=="" local M_married "`tm'"
 15.     else                 local M_married "`M_married' + `tm'"
 16. }

. 
. /********************************************************************/
. /*  7) ESTIMAR GMM CON W_RE FIJA (onestep)                            */
. /*     - esto implementa "ponderación RE"                             */
. /********************************************************************/
. gmm ///
>     (m0:        `Rsum') ///
>     (m_educ:    educ_bar    * (`Rsum')) ///
>     (m_experB:  exper_bar   * (`Rsum')) ///
>     (m_expersqB:expersq_bar * (`Rsum')) ///
>     (m_unionB:  union_bar   * (`Rsum')) ///
>     (m_marB:    married_bar * (`Rsum')) ///
>     (m_blackB:  black_bar   * (`Rsum')) ///
>     (m_experW:  `M_exper') ///
>     (m_expersqW:`M_expersq') ///
>     (m_unionW:  `M_union') ///
>     (m_marW:    `M_married'), ///
>     onestep winitial(W_RE) ///
>     `VCE' ///
>     title("GMM (11.4) con ponderación RE fijada (W_RE)")

