. 
. xtset id year

Panel variable: id (strongly balanced)
 Time variable: year, 1997 to 2000
         Delta: 1 unit

. sort id year

. 
. *------------------------------------------------------------*
. * Especificación 
. *------------------------------------------------------------*
. local y     "lpassen"

. local exog  "ldist ldistsq"

. local endog "lfare"

. local zexcl "concen"

. 
. * Chequeo mínimo
. foreach v in id year `y' `exog' `endog' `zexcl' {
  2.     cap confirm variable `v'
  3.     if _rc {
  4.         di as error "Falta la variable: `v'. (Revisá nombres en la base)."
  5.         exit 198
  6.     }
  7. }

. 
