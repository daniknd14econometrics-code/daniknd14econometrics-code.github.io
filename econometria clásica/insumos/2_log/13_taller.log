. ******************************** CF manual: caso sobreidentificado **************************   
.         
. **# Probit-IV: por CF caso sobreidentificado
. 
. cap program drop cf15_sob

. program define cf15_sob, rclass
  1.     version 16.0
  2.     tempvar vhat xb_full xb_nores xb_struct pdf_full pdf_struct
  3.     tempvar xb p pdf gres g1 g2
  4. 
.     *====================*
.     * (a) 1ra etapa (OLS)
.     *====================*
.     quietly regress nwifeinc educ exper expersq age kidslt6 kidsge6  huseduc motheduc fatheduc, vce(robust)
  5.     quietly predict double `vhat', resid
  6. 
.     return scalar pi_huseduc  = _b[huseduc]
  7.     return scalar pi_motheduc = _b[motheduc]
  8.     return scalar pi_fatheduc = _b[fatheduc]
  9. 
.     scalar tau2sq = e(rmse)^2
 10. 
.     *====================*
.     * (b) 2da etapa (CF probit)
.     *====================*
.     quietly probit inlf nwifeinc educ exper expersq age kidslt6 kidsge6 `vhat'
 11. 
.     return scalar br_nwifeinc = _b[nwifeinc]
 12.     return scalar br_educ     = _b[educ]
 13.     return scalar br_exper    = _b[exper]
 14.     return scalar br_expersq  = _b[expersq]
 15.     return scalar br_age      = _b[age]
 16.     return scalar br_kidslt6  = _b[kidslt6]
 17.     return scalar br_kidsge6  = _b[kidsge6]
 18.     return scalar br_vhat     = _b[`vhat']
 19. 
.     quietly predict double `xb_full', xb
 20. 
.     *====================*
.     * Vía A (APE con xb_full)
.     *====================*
.     quietly gen double `pdf_full' = exp(-0.5*(`xb_full')^2) / sqrt(2*_pi)
 21.     quietly summarize `pdf_full', meanonly
 22.     scalar meanpdf_full = r(mean)
 23. 
.     return scalar apev_nwifeinc = _b[nwifeinc] * meanpdf_full
 24.     return scalar apev_educ     = _b[educ]     * meanpdf_full
 25.     return scalar apev_exper    = _b[exper]    * meanpdf_full
 26.     return scalar apev_expersq  = _b[expersq]  * meanpdf_full
 27.     return scalar apev_age      = _b[age]      * meanpdf_full
 28.     return scalar apev_kidslt6  = _b[kidslt6]  * meanpdf_full
 29.     return scalar apev_kidsge6  = _b[kidsge6]  * meanpdf_full
 30. 
.     *====================*
.     * Vía B (escala + APE estructural)
.     *====================*
.     scalar scale = 1/sqrt(1 + (_b[`vhat']^2)*tau2sq)
 31.     return scalar scale = scale
 32. 
.     scalar bs_nwifeinc = _b[nwifeinc] * scale
 33.     scalar bs_educ     = _b[educ]     * scale
 34.     scalar bs_exper    = _b[exper]    * scale
 35.     scalar bs_expersq  = _b[expersq]  * scale
 36.     scalar bs_age      = _b[age]      * scale
 37.     scalar bs_kidslt6  = _b[kidslt6]  * scale
 38.     scalar bs_kidsge6  = _b[kidsge6]  * scale
 39. 
.     return scalar bs_nwifeinc = bs_nwifeinc
 40.     return scalar bs_educ     = bs_educ
 41.     return scalar bs_exper    = bs_exper
 42.     return scalar bs_expersq  = bs_expersq
 43.     return scalar bs_age      = bs_age
 44.     return scalar bs_kidslt6  = bs_kidslt6
 45.     return scalar bs_kidsge6  = bs_kidsge6
 46. 
.     quietly gen double `xb_nores'  = `xb_full' - _b[`vhat']*`vhat'
 47.     quietly gen double `xb_struct' = scale*`xb_nores'
 48. 
.     quietly gen double `pdf_struct' = exp(-0.5*(`xb_struct')^2) / sqrt(2*_pi)
 49.     quietly summarize `pdf_struct', meanonly
 50.     scalar meanpdf_struct = r(mean)
 51. 
.     return scalar apes_nwifeinc = bs_nwifeinc * meanpdf_struct
 52.     return scalar apes_educ     = bs_educ     * meanpdf_struct
 53.     return scalar apes_exper    = bs_exper    * meanpdf_struct
 54.     return scalar apes_expersq  = bs_expersq  * meanpdf_struct
 55.     return scalar apes_age      = bs_age      * meanpdf_struct
 56.     return scalar apes_kidslt6  = bs_kidslt6  * meanpdf_struct
 57.     return scalar apes_kidsge6  = bs_kidsge6  * meanpdf_struct
 58.         
.         * ===== "OVERID" Wooldridge (instrumentos extra) =====
. * Modelo auxiliar: agrego SOLO los instrumentos extra (no el base)
.     *     Extras: motheduc y fatheduc
.         *     observar que podriamos usar cualquier combinacion de 2 tomadas de 3 instruementos no triviales para esta prueba, elegimos ahora motheduc y fatheduc
.     * como la siguiente regresion la uso para luego aplicar un test, uso vce(robust)
. quietly probit inlf nwifeinc educ exper expersq age kidslt6 kidsge6 `vhat'  motheduc fatheduc, vce(robust)
 59. quietly test motheduc fatheduc
 60. 
. return scalar J_wald  = r(chi2)
 61. return scalar df_wald = r(df)
 62. return scalar p_wald  = r(p)
 63. 
. end

. 
. 
. 
