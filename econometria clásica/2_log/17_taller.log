. program define _post_bv, eclass
  1.     args bmat vmat nobs
  2.     ereturn post `bmat' `vmat', obs(`nobs')
  3.     ereturn local cmd "cf_apes_mlnvi_boot"
  4. end

. 
. _post_bv b_cf V_cf `=N0'

